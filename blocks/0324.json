{"page":324,"blocks":[{"x":0.04849,"y":0.05257,"w":0.19036,"h":0.01535,"fs":0.01535,"n":2,"k":1,"t":"310 Chapter 5: Integrals"},{"x":0.32332,"y":0.09317,"w":0.112,"h":0.01407,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 1"},{"x":0.32987,"y":0.12573,"w":0.09284,"h":0.02558,"fs":0.01151,"n":2,"k":1,"t":"A sum in sigma notation"},{"x":0.47792,"y":0.12573,"w":0.16113,"h":0.02558,"fs":0.01151,"n":2,"k":1,"t":"The sum written out, one term for each value of k"},{"x":0.72838,"y":0.12573,"w":0.06543,"h":0.02558,"fs":0.01151,"n":2,"k":1,"t":"The value of the sum"},{"x":0.3507,"y":0.17113,"w":0.3924,"h":0.01688,"fs":0.01151,"n":3,"k":0,"t":"k 1 + 2 + 3 + 4 + 5 15"},{"x":0.33172,"y":0.18921,"w":0.01792,"h":0.00824,"fs":0.00783,"n":1,"k":1,"t":"k=1"},{"x":0.3507,"y":0.2067,"w":0.49398,"h":0.01694,"fs":0.01151,"n":3,"k":0,"t":"(-1)k k (-1)1(1) + (-1)2(2) + (-1)3(3) -1 + 2 - 3 = -2"},{"x":0.33172,"y":0.22482,"w":0.01792,"h":0.00824,"fs":0.00783,"n":1,"k":1,"t":"k=1"},{"x":0.47881,"y":0.23939,"w":0.31665,"h":0.02497,"fs":0.01151,"n":8,"k":0,"t":"1 1 + 1 + 2 2 + 1 1 2 + 2 3 = 7 6"},{"x":0.35266,"y":0.24082,"w":0.03579,"h":0.02515,"fs":0.01151,"n":2,"k":1,"t":"k k + 1"},{"x":0.33172,"y":0.26028,"w":0.01792,"h":0.00824,"fs":0.00783,"n":1,"k":1,"t":"k=1"},{"x":0.47881,"y":0.27583,"w":0.08314,"h":0.02625,"fs":0.01151,"n":2,"k":0,"t":"4 - 1 + 52"},{"x":0.49092,"y":0.27599,"w":0.01234,"h":0.01278,"fs":0.01151,"n":1,"k":1,"t":"42"},{"x":0.53749,"y":0.27624,"w":0.28729,"h":0.026,"fs":0.01151,"n":5,"k":0,"t":"5 - 1 16 3 + 25 4 = 139 12"},{"x":0.36438,"y":0.27653,"w":0.01231,"h":0.01277,"fs":0.01151,"n":1,"k":1,"t":"k2"},{"x":0.35266,"y":0.29081,"w":0.03579,"h":0.01212,"fs":0.01151,"n":1,"k":1,"t":"k - 1"},{"x":0.33172,"y":0.29724,"w":0.01792,"h":0.00824,"fs":0.00783,"n":1,"k":1,"t":"k=4"},{"x":0.32332,"y":0.34199,"w":0.498,"h":0.01449,"fs":0.01407,"n":1,"k":0,"t":"EXAMPLE 2 Express the sum 1 + 3 + 5 + 7 + 9 in sigma notation."},{"x":0.32332,"y":0.3812,"w":0.59305,"h":0.04434,"fs":0.01279,"n":4,"k":1,"t":"Solution The formula generating the terms changes with the lower limit of summation, but the terms generated remain the same. It is often simplest to start with k = 0 or k = 1, but we can start with any integer."},{"x":0.38303,"y":0.45044,"w":0.35178,"h":0.01695,"fs":0.01279,"n":2,"k":0,"t":"Starting with k = 0: 1 + 3 + 5 + 7 + 9 = a"},{"x":0.73729,"y":0.45044,"w":0.05881,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"(2k + 1)"},{"x":0.71614,"y":0.46522,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=0"},{"x":0.38304,"y":0.49392,"w":0.35178,"h":0.01695,"fs":0.01279,"n":2,"k":0,"t":"Starting with k = 1: 1 + 3 + 5 + 7 + 9 = a"},{"x":0.73729,"y":0.49392,"w":0.05881,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"(2k - 1)"},{"x":0.71614,"y":0.50871,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.38304,"y":0.53484,"w":0.35178,"h":0.01695,"fs":0.01279,"n":2,"k":0,"t":"Starting with k = 2: 1 + 3 + 5 + 7 + 9 = a"},{"x":0.73729,"y":0.53484,"w":0.05881,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"(2k - 3)"},{"x":0.71614,"y":0.54963,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=2"},{"x":0.38304,"y":0.57577,"w":0.35408,"h":0.01695,"fs":0.01279,"n":2,"k":0,"t":"Starting with k = -3: 1 + 3 + 5 + 7 + 9 = a"},{"x":0.74191,"y":0.57577,"w":0.05881,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"(2k + 7)"},{"x":0.71498,"y":0.59056,"w":0.02694,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=-3"},{"x":0.35277,"y":0.62249,"w":0.19114,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"When we have a sum such as"},{"x":0.60086,"y":0.65944,"w":0.05614,"h":0.01421,"fs":0.01279,"n":1,"k":0,"t":"(k + k2)"},{"x":0.57971,"y":0.67496,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.32333,"y":0.69667,"w":0.1758,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"we can rearrange its terms,"},{"x":0.47403,"y":0.7317,"w":0.30059,"h":0.01421,"fs":0.01279,"n":1,"k":0,"t":"(k + k2) = (1 + 12) + (2 + 22) + (3 + 32)"},{"x":0.45288,"y":0.74722,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.53763,"y":0.76185,"w":0.34964,"h":0.01795,"fs":0.01279,"n":2,"k":0,"t":"= (1 + 2 + 3) + (12 + 22 + 32) Regroup terms."},{"x":0.6335,"y":0.80076,"w":0.01776,"h":0.01421,"fs":0.01279,"n":1,"k":1,"t":"k2."},{"x":0.53763,"y":0.8015,"w":0.0368,"h":0.01695,"fs":0.01279,"n":1,"k":1,"t":"= a"},{"x":0.57827,"y":0.8015,"w":0.05139,"h":0.01695,"fs":0.01279,"n":1,"k":1,"t":"k + a"},{"x":0.55576,"y":0.81628,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.61099,"y":0.81628,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.32332,"y":0.83735,"w":0.29365,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"This illustrates a general rule for finite sums:"},{"x":0.53569,"y":0.87248,"w":0.10493,"h":0.01695,"fs":0.01279,"n":1,"k":0,"t":"(ak + bk) = a"},{"x":0.6431,"y":0.87248,"w":0.05717,"h":0.01695,"fs":0.01279,"n":1,"k":1,"t":"ak + a"},{"x":0.70275,"y":0.87314,"w":0.01943,"h":0.01536,"fs":0.01279,"n":1,"k":1,"t":"bk ."},{"x":0.51454,"y":0.88726,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.62195,"y":0.88726,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.6816,"y":0.88726,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.32332,"y":0.90769,"w":0.5889,"h":0.02814,"fs":0.01279,"n":2,"k":1,"t":"Four such rules are given below. A proof that they are valid can be obtained using mathe- matical induction (see Appendix 2)."}]}