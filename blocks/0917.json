03437,"h":0.03453,"fs":0.01279,"n":2,"k":1,"t":"0 c 1"},{"x":0.76619,"y":0.29929,"w":0.04052,"h":0.0337,"fs":0.01279,"n":2,"k":1,"t":"2er2d 0"},{"x":0.80115,"y":0.29935,"w":0.02565,"h":0.02315,"fs":0.01279,"n":2,"k":1,"t":"1 du"},{"x":0.49434,"y":0.30219,"w":0.09004,"h":0.02031,"fs":0.01279,"n":1,"k":1,"t":"ex2+y2 dy dx ="},{"x":0.62772,"y":0.30734,"w":0.09464,"h":0.02648,"fs":0.01279,"n":2,"k":0,"t":"0 er2r dr du ="},{"x":0.46728,"y":0.32055,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"k":1,"t":"O R"},{"x":0.602,"y":0.32055,"w":0.03139,"h":0.01356,"fs":0.01279,"n":1,"k":1,"t":"0 L"},{"x":0.61932,"y":0.35173,"w":0.1778,"h":0.02787,"fs":0.01279,"n":3,"k":0,"t":"1 2 (e - 1) du = p 2 (e - 1)."},{"x":0.36258,"y":0.39175,"w":0.59303,"h":0.03052,"fs":0.01279,"n":2,"k":1,"t":"The r in the r dr du was just what we needed to integrate er2. Without it, we would have been unable to find an antiderivative for the first (innermost) iterated integral."},{"x":0.36258,"y":0.43847,"w":0.25646,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 4 Evaluate the integral"},{"x":0.60572,"y":0.46443,"w":0.03542,"h":0.00995,"fs":0.00895,"n":1,"k":1,"t":"21-x2"},{"x":0.59803,"y":0.47338,"w":0.15585,"h":0.02925,"fs":0.01401,"n":2,"k":1,"t":"0 (x2 + y2) dy dx."},{"x":0.57054,"y":0.48937,"w":0.03317,"h":0.01356,"fs":0.01279,"n":1,"k":1,"t":"0 L"},{"x":0.3626,"y":0.51605,"w":0.29672,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution Integration with respect to y gives"},{"x":0.53865,"y":0.53743,"w":0.21295,"h":0.04194,"fs":0.01279,"n":2,"k":0,"t":"0 ax2 21 - x2 + (1 - x2)3>2"},{"x":0.71125,"y":0.54484,"w":0.07451,"h":0.03035,"fs":0.01279,"n":2,"k":1,"t":"3 b dx,"},{"x":0.36259,"y":0.58981,"w":0.30035,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"an integral difficult to evaluate without tables."},{"x":0.36258,"y":0.60515,"w":0.59306,"h":0.05883,"fs":0.01279,"n":4,"k":1,"t":"Things go better if we change the original integral to polar coordinates. The region of integration in Cartesian coordinates is given by the inequalities 0 … y … 21 - x2 and 0 … x … 1, which correspond to the interior of the unit quarter circle x2 + y2 = 1 in the first quadrant. (See Figure 15.27, first quadrant.) Substituting the polar coordinates"},{"x":0.36258,"y":0.6561,"w":0.5881,"h":0.03858,"fs":0.01279,"n":2,"k":0,"t":"x = r cos u, y = r sin u, 0 … u … p>2, and 0 … r … 1, and replacing dx dy by r dr du in the double integral, we get"},{"x":0.19702,"y":0.69937,"w":0.08672,"h":0.01461,"fs":0.01023,"n":1,"k":0,"t":"z = 9 −x2 −y2"},{"x":0.64648,"y":0.69982,"w":0.01871,"h":0.01626,"fs":0.00895,"n":1,"k":1,"t":"p>2"},{"x":0.46042,"y":0.70614,"w":0.03542,"h":0.00995,"fs":0.00895,"n":1,"k":1,"t":"21-x2"},{"x":0.45273,"y":0.7151,"w":0.16877,"h":0.02925,"fs":0.01401,"n":2,"k":0,"t":"0 (x2 + y2) dy dx ="},{"x":0.67551,"y":0.71883,"w":0.09406,"h":0.02551,"fs":0.01401,"n":2,"k":0,"t":"0 (r2) r dr du"},{"x":0.42932,"y":0.73108,"w":0.02909,"h":0.01356,"fs":0.01279,"n":1,"k":1,"t":"0 L"},{"x":0.63912,"y":0.73108,"w":0.04207,"h":0.01327,"fs":0.01279,"n":2,"k":1,"t":"0 L"},{"x":0.64671,"y":0.7497,"w":0.01871,"h":0.01626,"fs":0.00895,"n":1,"k":1,"t":"p>2"},{"x":0.78186,"y":0.7497,"w":0.01871,"h":0.01626,"fs":0.00895,"n":1,"k":1,"t":"p>2"},{"x":0.70037,"y":0.75929,"w":0.01939,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"r=1"},{"x":0.63934,"y":0.75969,"w":0.05155,"h":0.03453,"fs":0.01279,"n":2,"k":1,"t":"0 c r4"},{"x":0.68046,"y":0.75969,"w":0.01745,"h":0.03044,"fs":0.01279,"n":1,"k":1,"t":"4 d"},{"x":0.80477,"y":0.76225,"w":0.07,"h":0.02787,"fs":0.01279,"n":3,"k":0,"t":"1 4 du = p 8 ."},{"x":0.72384,"y":0.76945,"w":0.03303,"h":0.01346,"fs":0.01279,"n":1,"k":1,"t":"du ="},{"x":0.70036,"y":0.78423,"w":0.01941,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"r=0"},{"x":0.36258,"y":0.79822,"w":0.58812,"h":0.01795,"fs":0.01279,"n":1,"k":1,"t":"Why is the polar coordinate transformation so effective here? One reason is that x2 + y2"},{"x":0.09764,"y":0.81041,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"k":0,"t":"−2"},{"x":0.36258,"y":0.81731,"w":0.48588,"h":0.01421,"fs":0.01279,"n":1,"k":1,"t":"simplifies to r2. Another is that the limits of integration become constants."},{"x":0.36258,"y":0.84772,"w":0.59306,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 5 Find the volume of the solid region bounded above by the paraboloid"},{"x":0.15139,"y":0.85877,"w":0.1261,"h":0.01938,"fs":0.01105,"n":2,"k":0,"t":"y x2 + y2 = 1"},{"x":0.36351,"y":0.85961,"w":0.40507,"h":0.01795,"fs":0.01279,"n":1,"k":1,"t":"z = 9 - x2 - y2 and below by the unit circle in the xy-plane."},{"x":0.09443,"y":0.87332,"w":0.03507,"h":0.02216,"fs":0.01023,"n":2,"k":1,"t":"2 x"},{"x":0.36258,"y":0.88647,"w":0.59304,"h":0.04864,"fs":0.01279,"n":4,"k":1,"t":"Solution The region of integration R is the unit circle x2 + y2 = 1, which is described in polar coordinates by r = 1, 0 … u … 2p. The solid region is shown in Figure 15.28. The volume is given by the double integral"},{"x":0.08775,"y":0.90796,"w":0.22737,"h":0.02762,"fs":0.01151,"n":3,"k":1,"t":"FIGURE 15.28 The solid region in Example 5."}]}