from the origin. The parabola in the plane"},{"x":0.32466,"y":0.41674,"w":0.15948,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"y = 0 opens downward."},{"x":0.35276,"y":0.43208,"w":0.50424,"h":0.01535,"fs":0.01279,"n":1,"k":0,"t":"If we cut the surface by a plane z = z0 7 0, the cross-section is a hyperbola,"},{"x":0.57141,"y":0.46006,"w":0.01312,"h":0.01419,"fs":0.01279,"n":1,"k":1,"t":"y2"},{"x":0.60934,"y":0.46145,"w":0.04994,"h":0.03136,"fs":0.01279,"n":1,"k":1,"t":"a2 = z0"},{"x":0.57111,"y":0.46251,"w":0.05174,"h":0.03029,"fs":0.01279,"n":1,"k":1,"t":"b2 - x2"},{"x":0.64985,"y":0.47113,"w":0.01523,"h":0.01697,"fs":0.01279,"n":1,"k":1,"t":"c ,"},{"x":0.32332,"y":0.5018,"w":0.59299,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"with its focal axis parallel to the y-axis and its vertices on the parabola in Equation (1). If"},{"x":0.32332,"y":0.51716,"w":0.5929,"h":0.02815,"fs":0.01279,"n":2,"k":1,"t":"z0 is negative, the focal axis is parallel to the x-axis and the vertices lie on the parabola in Equation (2)."},{"x":0.12893,"y":0.56978,"w":0.19894,"h":0.02369,"fs":0.01023,"n":4,"k":0,"t":"The parabola z = y2 in the yz-plane c b2"},{"x":0.53461,"y":0.58646,"w":0.01177,"h":0.01214,"fs":0.01023,"n":1,"k":1,"t":"y2"},{"x":0.56795,"y":0.58833,"w":0.01176,"h":0.01214,"fs":0.01023,"n":1,"k":1,"t":"x2"},{"x":0.4187,"y":0.59474,"w":0.18428,"h":0.01078,"fs":0.01023,"n":3,"k":1,"t":"Part of the hyperbola − = 1"},{"x":0.53425,"y":0.60186,"w":0.0125,"h":0.01214,"fs":0.01023,"n":1,"k":1,"t":"b2"},{"x":0.56758,"y":0.60186,"w":0.0125,"h":0.01214,"fs":0.01023,"n":1,"k":1,"t":"a2"},{"x":0.4187,"y":0.61265,"w":0.09268,"h":0.01078,"fs":0.01023,"n":1,"k":0,"t":"in the plane z = c"},{"x":0.19094,"y":0.62087,"w":0.01733,"h":0.01136,"fs":0.00767,"n":1,"k":1,"t":"HY"},{"x":0.20572,"y":0.62508,"w":0.01436,"h":0.0103,"fs":0.00767,"n":1,"k":1,"t":"PE"},{"x":0.22124,"y":0.65479,"w":0.03562,"h":0.02251,"fs":0.01023,"n":2,"k":1,"t":"Saddle point"},{"x":0.27137,"y":0.68808,"w":0.02131,"h":0.02346,"fs":