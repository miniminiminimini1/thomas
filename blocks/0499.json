":0.43396,"w":0.17731,"h":0.01867,"fs":0.0164,"n":1,"k":0,"t":"(3 - 1)(3 - 2)\u0006 (x - 3) \u0006"},{"x":0.66061,"y":0.46109,"w":0.0321,"h":0.02101,"fs":0.01023,"n":2,"k":1,"t":"A Cover"},{"x":0.39285,"y":0.52783,"w":0.26612,"h":0.032,"fs":0.01279,"n":2,"k":1,"t":"Heaviside Method 1. Write the quotient with g(x) factored:"},{"x":0.53555,"y":0.5695,"w":0.24309,"h":0.03102,"fs":0.01279,"n":4,"k":1,"t":"ƒ(x) g(x) = ƒ(x) (x - r1)(x - r2) g(x - rn)."},{"x":0.39286,"y":0.60902,"w":0.5125,"h":0.03033,"fs":0.01279,"n":2,"k":1,"t":"2. Cover the factors (x - ri) of g(x) one at a time, each time replacing all the uncovered x’s by the number ri. This gives a number Ai for each root ri:"},{"x":0.52968,"y":0.64741,"w":0.17964,"h":0.03148,"fs":0.01279,"n":3,"k":1,"t":"A1 = ƒ(r1) (r1 - r2) g(r1 - rn)"},{"x":0.52968,"y":0.68322,"w":0.2363,"h":0.04729,"fs":0.01279,"n":4,"k":1,"t":"A2 = ƒ(r2) (r2 - r1)(r2 - r3) g(r2 - rn) f"},{"x":0.52845,"y":0.73814,"w":0.2572,"h":0.03156,"fs":0.01279,"n":3,"k":1,"t":"An = ƒ(rn) (rn - r1)(rn - r2) g(rn - rn-1)."},{"x":0.39285,"y":0.76808,"w":0.35754,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"3. Write the partial fraction expansion of ƒ(x)>g(x) as"},{"x":0.50376,"y":0.8008,"w":0.30666,"h":0.03121,"fs":0.01279,"n":8,"k":0,"t":"ƒ(x) g(x) = A1 (x - r1) + A2 (x - r2) + g+ An (x - rn)."},{"x":0.36258,"y":0.88033,"w":0.37,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 7 Use the Heaviside Method to evaluate"},{"x":0.6007,"y":0.90613,"w":0.13045,"h":0.02957,"fs":0.01279,"n":2,"k":0,"t":"x + 4 x3 + 3x2 - 10x dx."}]}