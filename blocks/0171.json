99,"w":0.0132,"h":0.01419,"fs":0.01279,"n":1,"k":1,"t":"x2"},{"x":0.36258,"y":0.45724,"w":0.254,"h":0.01375,"fs":0.01375,"n":1,"k":1,"t":"Derivative of the Cosine Function"},{"x":0.36258,"y":0.4819,"w":0.41281,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"With the help of the angle sum formula for the cosine function,"},{"x":0.52492,"y":0.50424,"w":0.26422,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"cos(x + h) = cos x cos h - sin x sin h,"},{"x":0.36258,"y":0.52794,"w":0.33944,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"we can compute the limit of the difference quotient:"},{"x":0.53766,"y":0.54773,"w":0.13199,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"cos(x + h) - cos x"},{"x":0.42303,"y":0.55052,"w":0.11099,"h":0.02729,"fs":0.01279,"n":2,"k":0,"t":"d dx (cos x) = lim"},{"x":0.59955,"y":0.55965,"w":0.3127,"h":0.01815,"fs":0.01279,"n":2,"k":1,"t":"h Derivative definition"},{"x":0.51091,"y":0.56748,"w":0.02453,"h":0.01039,"fs":0.00895,"n":1,"k":1,"t":"hS0"},{"x":0.53828,"y":0.5852,"w":0.22963,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"(cos x cos h - sin x sin h) - cos x"},{"x":0.80428,"y":0.58557,"w":0.09306,"h":0.02302,"fs":0.01023,"n":2,"k":1,"t":"Cosine angle sum identity"},{"x":0.49455,"y":0.59453,"w":0.04011,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"= lim"},{"x":0.51154,"y":0.60495,"w":0.02453,"h":0.01039,"fs":0.00895,"n":1,"k":1,"t":"hS0"},{"x":0.53828,"y":0.62268,"w":0.20271,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"cos x(cos h - 1) - sin x sin h"},{"x":0.49455,"y":0.632,"w":0.04011,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"= lim"},{"x":0.51154,"y":0.64243,"w":0.02453,"h":0.01039,"fs":0.00895,"n":1,"k":1,"t":"hS0"},{"x":0.51154,"y":0.6586,"w":0.13729,"h":0.02913,"fs":0.01918,"n":1,"k":0,"t":"hS0cos x # cos h - 1"},{"x":0.67326,"y":0.6586,"w":0.09932,"h":0.02913,"fs":0.01918,"n":1,"k":0,"t":"hS0sin x # sin h"},{"x":0.49455,"y":0.66691,"w":0.04011,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"= lim"},{"x":0.61146,"y":0.66691,"w":0.08491,"h":0.02074,"fs":0.01279,"n":2,"k":1,"t