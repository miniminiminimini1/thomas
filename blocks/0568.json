,"n":5,"k":1,"t":"= 45y 2000 - 5t lb min."},{"x":0.32332,"y":0.60423,"w":0.03499,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Also,"},{"x":0.52452,"y":0.62832,"w":0.10809,"h":0.02323,"fs":0.01279,"n":1,"k":0,"t":"Rate in = a2 lb"},{"x":0.61632,"y":0.62832,"w":0.08223,"h":0.03052,"fs":0.01279,"n":1,"k":1,"t":"galb a40 gal"},{"x":0.67583,"y":0.62832,"w":0.03439,"h":0.03052,"fs":0.01279,"n":1,"k":1,"t":"minb"},{"x":0.57847,"y":0.66737,"w":0.05457,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"= 80 lb"},{"x":0.61397,"y":0.67457,"w":0.03125,"h":0.02008,"fs":0.01279,"n":1,"k":1,"t":"min."},{"x":0.32332,"y":0.70526,"w":0.37534,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"The differential equation modeling the mixture process is"},{"x":0.50795,"y":0.73396,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"dy"},{"x":0.50931,"y":0.73396,"w":0.2192,"h":0.02983,"fs":0.01279,"n":4,"k":0,"t":"dt = 80 - 45y 2000 - 5t Eq. (8)"},{"x":0.32332,"y":0.77432,"w":0.14268,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"in pounds per minute."},{"x":0.35277,"y":0.78967,"w":0.48614,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"To solve this differential equation, we first write it in standard linear form:"},{"x":0.53495,"y":0.8107,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"dy"},{"x":0.53631,"y":0.81316,"w":0.1644,"h":0.02736,"fs":0.01279,"n":3,"k":0,"t":"dt + 45 2000 - 5t y = 80."},{"x":0.32332,"y":0.84062,"w":0.46461,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"Thus, P(t) = 45>(2000 - 5t) and Q(t) = 80. The integrating factor is"},{"x":0.45665,"y":0.87659,"w":0.12294,"h":0.01795,"fs":0.01279,"n":1,"k":0,"t":"y(t) = e1 P dt = e1"},{"x":0.58127,"y":0.87724,"w":0.04152,"h":0.01473,"fs":0.0087,"n":2,"k":0,"t":"45 2000 - 5t dt"},{"x":0.54752,"y":0.90161,"w":0.23085,"h":0.03386,"fs":0.01279,"n":3,"k":0,"t":"= e-9 ln (2000-5t) 2000 - 5t 7 0 = (2000 - 5t)-9."}]}