7,"y":0.426,"w":0.24891,"h":0.02974,"fs":0.01279,"n":6,"k":0,"t":"0ƒ 0y = x + 0g 0y = x, or 0g 0y = 0."},{"x":0.32331,"y":0.46701,"w":0.24261,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"Hence, g is a function of z alone, and"},{"x":0.54333,"y":0.48681,"w":0.14893,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"ƒ(x, y, z) = xy + h(z)."},{"x":0.32332,"y":0.50796,"w":0.24946,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"The third of Equations (4) tells us that"},{"x":0.46269,"y":0.52848,"w":0.31028,"h":0.03023,"fs":0.01279,"n":5,"k":0,"t":"0ƒ 0z = 0 + dh dz = 4, or h(z) = 4z + C."},{"x":0.32332,"y":0.56934,"w":0.06858,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Therefore,"},{"x":0.53115,"y":0.58912,"w":0.17329,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"ƒ(x, y, z) = xy + 4z + C."},{"x":0.32332,"y":0.60959,"w":0.58893,"h":0.02882,"fs":0.01279,"n":2,"k":1,"t":"The value of the line integral is independent of the path taken from (1, 1, 1) to (2, 3, -1), and equals"},{"x":0.44294,"y":0.64795,"w":0.34971,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"ƒ(2, 3, -1) - ƒ(1, 1, 1) = 2 + C - (5 + C) = -3."},{"x":0.04643,"y":0.70773,"w":0.17484,"h":0.02814,"fs":0.02814,"n":1,"k":0,"t":"Exercises 16.3"},{"x":0.50736,"y":0.74421,"w":0.24526,"h":0.01212,"fs":0.01151,"n":1,"k":0,"t":"8. F = (y + z)i + (x + z)j + (x + y)k"},{"x":0.04849,"y":0.74624,"w":0.39538,"h":0.02609,"fs":0.01151,"n":2,"k":1,"t":"Testing for Conservative Fields Which fields in Exercises 1–6 are conservative, and which are not?"},{"x":0.50736,"y":0.76103,"w":0.17163,"h":0.01321,"fs":0.01151,"n":1,"k":0,"t":"9. F = ey+2z(i + xj + 2xk)"},{"x":0.05585,"y":0.77811,"w":0.15158,"h":0.01211,"fs":0.01151,"n":1,"k":0,"t":"1. F = yzi + xzj + xyk"},{"x":0.5,"y":0.78002,"w":0.2659,"h":0.01212,"fs":0.01151,"n":1,"k":1,"t":"10. F = (y sin z)i + (x sin z)j + (xycos z)k"},{"x":0.05585,"y":0.79602,"w":0.25936,"h":0.01212,"fs":0.01151,"n":1,"k":1,"t":"2. F = (y sin z)i + (x sin z)j + (xycos z)k"},{"x":0.5,"y":0.79726,"w":0.19957,"h":0.01279,"fs":0.01151,