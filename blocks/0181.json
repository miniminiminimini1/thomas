0,"t":"180b = p 180cos a px 180b = p 180cos(x°)."},{"x":0.45988,"y":0.85351,"w":0.09851,"h":0.02728,"fs":0.01279,"n":2,"k":1,"t":"d dxsin(x°) = d"},{"x":0.36258,"y":0.88097,"w":0.47434,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"See Figure 3.27. Similarly, the derivative of cos(x°) is -(p>180)sin(x°)."},{"x":0.36258,"y":0.89632,"w":0.58901,"h":0.03858,"fs":0.01279,"n":2,"k":1,"t":"The factor p>180 would compound with repeated differentiation, showing an advan- tage for the use of radian measure in computations."}]}