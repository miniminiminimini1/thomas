9,"n":6,"k":0,"t":"1 5n = 1 5 + 1 25 + 1 125 + a"},{"x":0.7157,"y":0.59434,"w":0.01373,"h":0.02719,"fs":0.01279,"n":2,"k":1,"t":"1 5n"},{"x":0.50689,"y":0.61548,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1"},{"x":0.69207,"y":0.61548,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=4"},{"x":0.32332,"y":0.63207,"w":0.02362,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"and"},{"x":0.51716,"y":0.65104,"w":0.06848,"h":0.0306,"fs":0.01279,"n":2,"k":0,"t":"1 5n = a a"},{"x":0.59029,"y":0.65104,"w":0.15258,"h":0.0306,"fs":0.01279,"n":6,"k":0,"t":"1 5nb - 1 5 - 1 25 - 1 125."},{"x":0.49352,"y":0.67559,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=4"},{"x":0.56665,"y":0.67559,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1"},{"x":0.32331,"y":0.69985,"w":0.59303,"h":0.04348,"fs":0.01279,"n":3,"k":1,"t":"The convergence or divergence of a series is not affected by its first few terms. Only the “tail” of the series, the part that remains when we sum beyond some finite number of ini- tial terms, influences whether it converges or diverges."},{"x":0.05994,"y":0.70899,"w":0.1615,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"HISTORICAL BIOGRAPHY"},{"x":0.05994,"y":0.72446,"w":0.10619,"h":0.02365,"fs":0.01023,"n":2,"k":1,"t":"Richard Dedekind (1831–1916)"},{"x":0.32332,"y":0.766,"w":0.08503,"h":0.01375,"fs":0.01375,"n":1,"k":1,"t":"Reindexing"},{"x":0.32332,"y":0.79065,"w":0.59303,"h":0.04499,"fs":0.01279,"n":3,"k":1,"t":"As long as we preserve the order of its terms, we can reindex any series without altering its convergence. To raise the starting value of the index h units, replace the n in the formula for an by n - h:"},{"x":0.49426,"y":0.85008,"w":0.06452,"h":0.01695,"fs":0.01279,"n":2,"k":1,"t":"an = a"},{"x":0.57007,"y":0.85008,"w":0.19565,"h":0.01535,"fs":0.01279,"n":1,"k":0,"t":"an-h = a1 + a2 + a3 + g."},{"x":0.4707,"y":0.86486,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1"},{"x":0.53225,"y":0.86486,"w":0.03574,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1+h"},{"x":0.32333,"y":0.88077,"w":0.58814,"h":0.01498,"fs":0.01279,"n":1,"k":1,"t":"To lower the starting value of the index h units, replace the n in the formula for an by n + h:"},{"x":0.49426,"y":0.91019,"w":0.06452,"h":0.01695,"fs":0.01279,"n":2,"k":1,"t":"an = a"},{"x":0.57007,"y":0.91019,"w":0.19565,"h":0.01535,"fs":0.01279,"n":1,"k":0,"t":"an+h = a1 + a2 + a3 + g."},{"x":0.4707,"y":0.92497,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1"},{"x":0.53225,"y":0.92497,"w":0.03574,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"n=1-h"}]}