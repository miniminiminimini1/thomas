{"page":478,"blocks":[{"x":0.04849,"y":0.05257,"w":0.29299,"h":0.01535,"fs":0.01535,"n":2,"k":1,"t":"464 Chapter 8: Techniques of Integration"},{"x":0.32332,"y":0.09317,"w":0.17855,"h":0.01449,"fs":0.01407,"n":2,"k":1,"t":"EXAMPLE 4 Evaluate"},{"x":0.59022,"y":0.12237,"w":0.07279,"h":0.01727,"fs":0.01279,"n":1,"k":1,"t":"ex cos x dx."},{"x":0.32331,"y":0.16455,"w":0.4976,"h":0.01728,"fs":0.01279,"n":2,"k":1,"t":"Solution Let u = ex and dy = cos x dx. Then du = ex dx, y = sin x, and"},{"x":0.50079,"y":0.19654,"w":0.15657,"h":0.01727,"fs":0.01279,"n":1,"k":0,"t":"ex cos x dx = ex sin x -"},{"x":0.68237,"y":0.19654,"w":0.07007,"h":0.01727,"fs":0.01279,"n":1,"k":1,"t":"ex sin x dx."},{"x":0.32333,"y":0.2317,"w":0.59312,"h":0.02815,"fs":0.01279,"n":2,"k":1,"t":"The second integral is like the first except that it has sin x in place of cos x. To evaluate it, we use integration by parts with"},{"x":0.41454,"y":0.26559,"w":0.40651,"h":0.01728,"fs":0.01279,"n":4,"k":0,"t":"u = ex, dy = sin x dx, y = -cos x, du = ex dx."},{"x":0.32332,"y":0.2931,"w":0.03362,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Then"},{"x":0.43446,"y":0.31463,"w":0.25194,"h":0.02323,"fs":0.01279,"n":1,"k":0,"t":"ex cos x dx = ex sin x - a-ex cos x -"},{"x":0.71141,"y":0.31463,"w":0.10653,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"(-cos x)(ex dx)b"},{"x":0.51053,"y":0.36024,"w":0.15408,"h":0.01727,"fs":0.01279,"n":1,"k":0,"t":"= ex sin x + ex cos x -"},{"x":0.68962,"y":0.36024,"w":0.07279,"h":0.01727,"fs":0.01279,"n":1,"k":1,"t":"ex cos x dx."},{"x":0.32331,"y":0.39541,"w":0.59292,"h":0.02814,"fs":0.01279,"n":2,"k":1,"t":"The unknown integral now appears on both sides of the equation. Adding the integral to both sides and adding the constant of integration give"},{"x":0.50188,"y":0.43826,"w":0.25763,"h":0.01879,"fs":0.01279,"n":1,"k":0,"t":"ex cos x dx = ex sin x + ex cos x + C1."},{"x":0.47606,"y":0.44273,"w":0.02414,"h":0.02362,"fs":0.01279,"n":2,"k":1,"t":"2 L"},{"x":0.32331,"y":0.47343,"w":0.39082,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Dividing by 2 and renaming the constant of integration give"},{"x":0.50029,"y":0.49373,"w":0.21327,"h":0.02446,"fs":0.01279,"n":1,"k":0,"t":"ex cos x dx = ex sin x + ex cos x"},{"x":0.6494,"y":0.50472,"w":0.10355,"h":0.02067,"fs":0.01279,"n":2,"k":1,"t":"2 + C."},{"x":0.32332,"y":0.55933,"w":0.40655,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 5 Obtain a formula that expresses the integral"},{"x":0.59772,"y":0.58851,"w":0.05782,"h":0.01728,"fs":0.01279,"n":1,"k":1,"t":"cosn x dx"},{"x":0.32332,"y":0.62368,"w":0.31786,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"in terms of an integral of a lower power of cos x."},{"x":0.32332,"y":0.64156,"w":0.44278,"h":0.02238,"fs":0.01918,"n":2,"k":1,"t":"Solution We may think of cosn x as cosn-1 x # cos x. Then we let"},{"x":0.48187,"y":0.66908,"w":0.27183,"h":0.01728,"fs":0.01279,"n":3,"k":0,"t":"u = cosn-1 x and dy = cos x dx,"},{"x":0.32332,"y":0.6966,"w":0.04317,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"so that"},{"x":0.4271,"y":0.71512,"w":0.38137,"h":0.01728,"fs":0.01279,"n":3,"k":0,"t":"du = (n - 1) cosn-2 x (-sin x dx) and y = sin x."},{"x":0.32332,"y":0.74264,"w":0.19811,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Integration by parts then gives"},{"x":0.38108,"y":0.77012,"w":0.2459,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"cosn x dx = cosn-1 x sin x + (n - 1)"},{"x":0.64464,"y":0.77012,"w":0.1129,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"sin2 x cosn-2 x dx"},{"x":0.44622,"y":0.80976,"w":0.18076,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"= cosn-1 x sin x + (n - 1)"},{"x":0.64464,"y":0.80976,"w":0.15871,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"(1 - cos2 x) cosn-2 x dx"},{"x":0.44622,"y":0.84941,"w":0.18077,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"= cosn-1 x sin x + (n - 1)"},{"x":0.64464,"y":0.84941,"w":0.14882,"h":0.01728,"fs":0.01279,"n":1,"k":0,"t":"cosn-2 x dx - (n - 1)"},{"x":0.8111,"y":0.84941,"w":0.06188,"h":0.01728,"fs":0.01279,"n":1,"k":1,"t":"cosn x dx."},{"x":0.32333,"y":0.88459,"w":0.06177,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"If we add"},{"x":0.62351,"y":0.91847,"w":0.05782,"h":0.01728,"fs":0.01279,"n":1,"k":1,"t":"cosn x dx"},{"x":0.55429,"y":0.92228,"w":0.05158,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"(n - 1)"}]}