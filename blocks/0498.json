,"n":2,"k":0,"t":"x dx x2 + 1 -"},{"x":0.69211,"y":0.41761,"w":0.06215,"h":0.0289,"fs":0.01279,"n":2,"k":0,"t":"x dx (x2 + 1)2"},{"x":0.55075,"y":0.42415,"w":0.0284,"h":0.01771,"fs":0.01279,"n":1,"k":1,"t":"x -"},{"x":0.84192,"y":0.45714,"w":0.06703,"h":0.02715,"fs":0.01023,"n":2,"k":0,"t":"u = x2 + 1, du = 2xdx"},{"x":0.54666,"y":0.45726,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"dx"},{"x":0.58657,"y":0.45726,"w":0.04233,"h":0.03083,"fs":0.01279,"n":2,"k":1,"t":"2L du"},{"x":0.65341,"y":0.45726,"w":0.04233,"h":0.03083,"fs":0.01279,"n":2,"k":1,"t":"2L du"},{"x":0.55075,"y":0.45744,"w":0.04401,"h":0.02406,"fs":0.01279,"n":1,"k":1,"t":"x - 1"},{"x":0.61664,"y":0.45744,"w":0.04495,"h":0.02399,"fs":0.01279,"n":1,"k":1,"t":"u - 1"},{"x":0.68087,"y":0.47195,"w":0.0134,"h":0.01419,"fs":0.01279,"n":1,"k":1,"t":"u2"},{"x":0.51193,"y":0.48719,"w":0.08531,"h":0.02588,"fs":0.01353,"n":1,"k":0,"t":"= ln 0 x0 - 1"},{"x":0.58907,"y":0.48719,"w":0.1251,"h":0.03309,"fs":0.01353,"n":2,"k":0,"t":"2 ln 0 u0 + 1 2u + K"},{"x":0.51193,"y":0.51916,"w":0.08531,"h":0.02588,"fs":0.01353,"n":1,"k":0,"t":"= ln 0 x0 - 1"},{"x":0.58907,"y":0.52522,"w":0.2184,"h":0.02919,"fs":0.01401,"n":3,"k":0,"t":"2 ln (x2 + 1) + 1 2(x2 + 1) + K"},{"x":0.51194,"y":0.54843,"w":0.07196,"h":0.03626,"fs":0.01353,"n":2,"k":1,"t":"= ln 0 x0"},{"x":0.5474,"y":0.56487,"w":0.19399,"h":0.03068,"fs":0.01401,"n":4,"k":0,"t":"2x2 + 1 + 1 2(x2 + 1) + K."},{"x":0.32332,"y":0.60927,"w":0.39887,"h":0.01375,"fs":0.01375,"n":1,"k":1,"t":"The Heaviside “Cover-up” Method for Linear Factors"},{"x":0.05994,"y":0.61956,"w":0.1615,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"HISTORICAL BIOGRAPHY"},{"x":0.32332,"y":0.63391,"w":0.48785,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"When the degree of the polynomial ƒ(x) is less than the degree of g(x) and"},{"x":0.05994,"y":0.63503,"w":0.09789,"h":0.02365,"fs":0.01023,"n":2,"k":1,"t":"Oliver Heaviside (1850–1925)"},{"x":0.49923,"y":0.65627,"w":0.23712,"h":0.01499,"fs":0.01279,"n":1,"k":1,"t":"g(x) = (x - r1)(x - r2) g(x - rn)"},{"x":0.32332,"y":0.67995,"w":0.59311,"h":0.02815,"fs":0.01279,"n":2,"k":1,"t":"is a product of n distinct linear factors, each raised to the first power, there is a quick way to expand ƒ(x)>g(x) by partial fractions."},{"x":0.32332,"y":0.73198,"w":0.44272,"h":0.01449,"fs":0.01407,"n":2,"k":1,"t":"EXAMPLE 6 Find A, B, and C in the partial fraction expansion"},{"x":0.44279,"y":0.7533,"w":0.46947,"h":0.03235,"fs":0.01279,"n":9,"k":0,"t":"x2 + 1 (x - 1)(x - 2)(x - 3) = A x - 1 + B x - 2 + C x - 3. (3)"},{"x":0.32332,"y":0.80061,"w":0.46079,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution If we multiply both sides of Equation (3) by (x - 1) to get"},{"x":0.46464,"y":0.82108,"w":0.22067,"h":0.03235,"fs":0.01279,"n":2,"k":0,"t":"x2 + 1 (x - 2)(x - 3) = A + B(x - 1)"},{"x":0.63515,"y":0.82343,"w":0.13621,"h":0.03,"fs":0.01279,"n":2,"k":0,"t":"x - 2 + C(x - 1)"},{"x":0.72072,"y":0.83988,"w":0.03976,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"x - 3"},{"x":0.32333,"y":0.86345,"w":0.37923,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"and set x = 1, the resulting equation gives the value of A:"},{"x":0.5149,"y":0.88162,"w":0.20667,"h":0.03448,"fs":0.01279,"n":2,"k":0,"t":"(1)2 + 1 (1 - 2)(1 - 3) = A + 0 + 0,"},{"x":0.60819,"y":0.92228,"w":0.04656,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"A = 1."}]}