"fs":0.01279,"n":2,"k":1,"t":"dy dx 2"},{"x":0.5904,"y":0.53744,"w":0.15634,"h":0.03121,"fs":0.01918,"n":1,"k":0,"t":"x=x0 = ƒ′(g(x0)) # g′(x0)."},{"x":0.36259,"y":0.58412,"w":0.58894,"h":0.02882,"fs":0.01279,"n":2,"k":1,"t":"Let ∆x be an increment in x and let ∆u and ∆y be the corresponding increments in u and y. Applying Equation (1) we have"},{"x":0.50902,"y":0.62632,"w":0.2969,"h":0.01535,"fs":0.01279,"n":1,"k":0,"t":"∆u = g′(x0)∆x + P1 ∆x = (g′(x0) + P1)∆x,"},{"x":0.36258,"y":0.65222,"w":0.23828,"h":0.01631,"fs":0.01279,"n":1,"k":0,"t":"where P1 S 0 as ∆x S 0. Similarly,"},{"x":0.50722,"y":0.68004,"w":0.30049,"h":0.01535,"fs":0.01279,"n":1,"k":0,"t":"∆y = ƒ′(u0)∆u + P2 ∆u = (ƒ′(u0) + P2)∆u,"},{"x":0.36258,"y":0.70594,"w":0.593,"h":0.02978,"fs":0.01279,"n":2,"k":0,"t":"where P2 S 0 as ∆u S 0. Notice also that ∆u S 0 as ∆x S 0. Combining the equations for ∆u and ∆y gives"},{"x":0.53759,"y":0.7491,"w":0.23977,"h":0.01499,"fs":0.01279,"n":1,"k":0,"t":"∆y = (ƒ′(u0) + P2)(g′(x0) + P1)∆x,"},{"x":0.36258,"y":0.77664,"w":0.01454,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"so"},{"x":0.49406,"y":0.80467,"w":0.32689,"h":0.03089,"fs":0.01279,"n":2,"k":0,"t":"∆y ∆x = ƒ′(u0)g′(x0) + P2g′(x0) + ƒ′(u0)P1 + P2P1."},{"x":0.36258,"y":0.85269,"w":0.59307,"h":0.02882,"fs":0.01279,"n":2,"k":1,"t":"Since P1 and P2 go to zero as ∆x goes to zero, the last three terms on the right vanish in the limit, leaving"},{"x":0.47866,"y":0.87892,"w":0.01973,"h":0.05206,"fs":0.01279,"n":2,"k":1,"t":"dy dx 2"},{"x":0.58477,"y":0.90059,"w":0.25074,"h":0.03089,"fs":0.01918,"n":2,"k":0,"t":"∆y ∆x = ƒ′(u0)g′(x0) = ƒ′(g(x0)) # g′(x0)."},{"x":0.50163,"y":0.91024,"w":0.07502,"h":0.02289,"fs":0.01279,"n":1,"k":1,"t":"x=x0 = lim"},{"x":0.55003,"y":0.92067,"w":0.03171,"h":0.01039,"fs":0.00895,"n":1,"k":1,"t":"∆xS0"}]}