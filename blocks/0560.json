56,"h":0.02862,"fs":0.01279,"n":2,"k":0,"t":"1 x3y = - 1"},{"x":0.59285,"y":0.76553,"w":0.04711,"h":0.01771,"fs":0.01279,"n":1,"k":1,"t":"x + C."},{"x":0.32333,"y":0.79689,"w":0.37605,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"Solving this last equation for y gives the general solution:"},{"x":0.46633,"y":0.81179,"w":0.07898,"h":0.02771,"fs":0.01279,"n":1,"k":0,"t":"y = x3 a- 1"},{"x":0.5376,"y":0.81626,"w":0.2322,"h":0.02747,"fs":0.01279,"n":2,"k":0,"t":"x + Cb = -x2 + Cx3, x 7 0."},{"x":0.32332,"y":0.87509,"w":0.31711,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 3 Find the particular solution of"},{"x":0.50683,"y":0.89913,"w":0.22192,"h":0.01347,"fs":0.01279,"n":2,"k":0,"t":"3xy′ - y = ln x + 1, x 7 0,"},{"x":0.32332,"y":0.92215,"w":0.14322,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"satisfying y(1) = -2."}]}