rectrix in Example 1."},{"x":0.51831,"y":0.29725,"w":0.03983,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"x = a"},{"x":0.55043,"y":0.30379,"w":0.16727,"h":0.01763,"fs":0.01279,"n":3,"k":0,"t":"e = 1, so a = e."},{"x":0.32333,"y":0.32472,"w":0.56613,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"When combined with the equation e = c>a that defines eccentricity, these results give"},{"x":0.45812,"y":0.36631,"w":0.03939,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"e = c"},{"x":0.48978,"y":0.36633,"w":0.04087,"h":0.02406,"fs":0.01279,"n":1,"k":1,"t":"a = 3"},{"x":0.52293,"y":0.36837,"w":0.25453,"h":0.02211,"fs":0.01279,"n":5,"k":0,"t":"e, so e2 = 3 and e = 23."},{"x":0.32332,"y":0.39523,"w":0.58811,"h":0.03713,"fs":0.01918,"n":2,"k":1,"t":"Knowing e, we can now derive the equation we want from the equation PF = e # PD. In the coordinates of Figure 11.49, we have"},{"x":0.59008,"y":0.43359,"w":0.21986,"h":0.02238,"fs":0.01918,"n":2,"k":0,"t":"PF = e # PD Eq. (4)"},{"x":0.45665,"y":0.46429,"w":0.36425,"h":0.01795,"fs":0.01279,"n":2,"k":0,"t":"2(x - 3)2 + (y - 0)2 = 23 \u0007 x - 1\u0007 e = 23"},{"x":0.48815,"y":0.48987,"w":0.38172,"h":0.01795,"fs":0.01401,"n":2,"k":0,"t":"x2 - 6x + 9 + y2 = 3(x2 - 2x + 1) Square both sides."},{"x":0.55167,"y":0.51672,"w":0.09134,"h":0.01795,"fs":0.01279,"n":1,"k":0,"t":"2x2 - y2 = 6"},{"x":0.5619,"y":0.54918,"w":0.04831,"h":0.03099,"fs":0.01279,"n":1,"k":0,"t":"3 - y2"},{"x":0.55939,"y":0.55163,"w":0.0132,"h":0.01419,"fs":0.01279,"n":1,"k":1,"t":"x2"},{"x":0.59956,"y":0.55957,"w":0.04733,"h":0.02076,"fs":0.01279,"n":1,"k":0,"t":"6 = 1."},{"x":0.32332,"y":0.61233,"w":0.12066,"h":0.01375,"fs":0.01375,"n":1,"k":1,"t":"Polar Equations"},{"x":0.32332,"y":0.63698,"w":0.59298,"h":0.02814,"fs":0.01279,"n":2,"k":1,"t":"To find a polar equation for an ellipse, parabola, or hyperbola, we place one focus at the origin and the corresponding directrix to the right of the origin along the vertical line"},{"x":0.32456,"y":0.66699,"w":0.35509,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"x = k (Figure 11.50). In polar coordinates, this makes"},{"x":0.17287,"y":0.67906,"w":0.04724,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"Directrix"},{"x":0.32332,"y":0.69001,"w":0.31966,"h":0.02882,"fs":0.01279,"n":2,"k":1,"t":"PF = r and"},{"x":0.04849,"y":0.72189,"w":0.04379,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"Focus at"},{"x":0.51694,"y":0.72838,"w":0.20182,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"PD = k - FB = k - r cos u."},{"x":0.06101,"y":0.73383,"w":0.03126,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"origin"},{"x":0.32332,"y":0.74309,"w":0.423,"h":0.02238,"fs":0.01918,"n":1,"k":1,"t":"The conic’s focus–directrix equation PF = e # PD then becomes"},{"x":0.21345,"y":0.75193,"w":0.03105,"h":0.01777,"fs":0.01023,"n":2,"k":1,"t":"x k"},{"x":0.08941,"y":0.76114,"w":0.04516,"h":0.01023,"fs":0.01023,"n":2,"k":1,"t":"F B"},{"x":0.08662,"y":0.77191,"w":0.03536,"h":0.01078,"fs":0.01023,"n":1,"k":1,"t":"r cos u"},{"x":0.55344,"y":0.77442,"w":0.12871,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"r = e(k - r cos u),"},{"x":0.32332,"y":0.79811,"w":0.39758,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"which can be solved for r to obtain the following expression."},{"x":0.07193,"y":0.79895,"w":0.06994,"h":0.03412,"fs":0.01023,"n":1,"k":1,"t":"Conic section"},{"x":0.1902,"y":0.80653,"w":0.02907,"h":0.01077,"fs":0.01023,"n":1,"k":1,"t":"x = k"},{"x":0.35359,"y":0.84586,"w":0.32324,"h":0.01293,"fs":0.01279,"n":1,"k":1,"t":"Polar Equation for a Conic with Eccentricity e"},{"x":0.04849,"y":0.84625,"w":0.25271,"h":0.089,"fs":0.01151,"n":7,"k":1,"t":"FIGURE 11.50 If a conic section is put in the position with its focus placed at the origin and a directrix perpendicular to the initial ray and right of the origin, we can find its polar equation from the conic’s focus–directrix equation."},{"x":0.56153,"y":0.8695,"w":0.32047,"h":0.02721,"fs":0.01279,"n":4,"k":0,"t":"r = ke 1 + e cos u, (5)"},{"x":0.3536,"y":0.90672,"w":0.27427,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"w