":0.68908,"w":0.593,"h":0.03858,"fs":0.01407,"n":2,"k":1,"t":"EXAMPLE 1 Find the Taylor series generated by ƒ(x) = 1>x at a = 2. Where, if anywhere, does the series converge to 1>x?"},{"x":0.36259,"y":0.74087,"w":0.50174,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution We need to find ƒ(2), ƒ′(2), ƒ″(2), c. Taking derivatives we get"},{"x":0.41117,"y":0.76286,"w":0.52122,"h":0.01526,"fs":0.01279,"n":5,"k":1,"t":"ƒ(x) = x-1, ƒ′(x) = -x-2, ƒ″(x) = 2!x-3, g, ƒ(n)(x) = (-1)nn!x-(n+1),"},{"x":0.36258,"y":0.78777,"w":0.04317,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"so that"},{"x":0.7459,"y":0.80626,"w":0.12427,"h":0.03253,"fs":0.01279,"n":3,"k":0,"t":"23, g, ƒ(n)(2)"},{"x":0.84331,"y":0.80642,"w":0.08726,"h":0.03075,"fs":0.01279,"n":2,"k":0,"t":"n! = (-1)n"},{"x":0.60531,"y":0.80701,"w":0.07108,"h":0.03186,"fs":0.01279,"n":2,"k":0,"t":"22, ƒ″(2)"},{"x":0.40623,"y":0.81015,"w":0.10483,"h":0.01982,"fs":0.01279,"n":1,"k":0,"t":"ƒ(2) = 2-1 = 1"},{"x":0.50288,"y":0.81015,"w":0.11338,"h":0.02703,"fs":0.01279,"n":2,"k":0,"t":"2, ƒ′(2) = - 1"},{"x":0.65284,"y":0.81015,"w":0.10401,"h":0.02703,"fs":0.01279,"n":2,"k":0,"t":"2! = 2-3 = 1"},{"x":0.89822,"y":0.81718,"w":0.0391,"h":0.02169,"fs":0.01279,"n":1,"k":0,"t":"2n+1 ."},{"x":0.36258,"y":0.8466,"w":0.12788,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"The Taylor series is"},{"x":0.60718,"y":0.86509,"w":0.30249,"h":0.03133,"fs":0.01279,"n":3,"k":0,"t":"2! (x - 2)2 + g + ƒ(n)(2) n! (x - 2)n + g"},{"x":0.43793,"y":0.86584,"w":0.19281,"h":0.02296,"fs":0.01279,"n":1,"k":0,"t":"ƒ(2) + ƒ′(2)(x - 2) + ƒ″(2)"},{"x":0.68908,"y":0.90234,"w":0.20249,"h":0.03236,"fs":0.01279,"n":2,"k":0,"t":"23 - g + (-1)n(x - 2)n"},{"x":0.56,"y":0.90235,"w":0.16404,"h":0.03243,"fs":0.01279,"n":3,"k":0,"t":"2 - (x - 2) 22 + (x - 2)2"},{"x":0.54293,"y":0.90606,"w":0.02526,"h":0.01982,"fs":0.01279,"n":1,"k":1,"t":"= 1"},{"x":0.84905,"y":0.91242,"w":0.09553,"h":0.02237,"fs":0.01279,"n":2,"k":1,"t":"2n+1 + g."}]}