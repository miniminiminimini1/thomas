,"fs":0.01023,"n":1,"k":0,"t":"−2"},{"x":0.58037,"y":0.718,"w":0.04225,"h":0.02945,"fs":0.01279,"n":2,"k":1,"t":"lim xS q 1"},{"x":0.61491,"y":0.72441,"w":0.04031,"h":0.02149,"fs":0.01279,"n":1,"k":1,"t":"x = 0"},{"x":0.11989,"y":0.73951,"w":0.01745,"h":0.01164,"fs":0.01023,"n":1,"k":0,"t":"−4"},{"x":0.32332,"y":0.75701,"w":0.14991,"h":0.01427,"fs":0.01279,"n":1,"k":1,"t":"and on the left because"},{"x":0.11989,"y":0.76798,"w":0.01745,"h":0.01164,"fs":0.01023,"n":1,"k":0,"t":"−6"},{"x":0.57402,"y":0.78067,"w":0.05085,"h":0.03041,"fs":0.01279,"n":2,"k":0,"t":"lim xS - q 1"},{"x":0.61716,"y":0.78708,"w":0.04438,"h":0.02149,"fs":0.01279,"n":1,"k":1,"t":"x = 0."},{"x":0.32332,"y":0.79088,"w":0.49607,"h":0.06906,"fs":0.01279,"n":1,"k":1,"t":"We say that the x-axis is a horizontal asymptote of the graph of ƒ(x) = 1>x."},{"x":0.11989,"y":0.79614,"w":0.01745,"h":0.01164,"fs":0.01023,"n":1,"k":0,"t":"−8"},{"x":0.04849,"y":0.83303,"w":0.22649,"h":0.072,"fs":0.01218,"n":3,"k":1,"t":"Figure 2.52 The graph of the function in Example 3b. The graph approaches the x-axis as 0 x0 increases."},{"x":0.35358,"y":0.85557,"w":0.52838,"h":0.03296,"fs":0.01279,"n":2,"k":1,"t":"DEFINITION A line y = b is a horizontal asymptote of the graph of a func- tion y = ƒ(x) if either"},{"x":0.47971,"y":0.89432,"w":0.20082,"h":0.02305,"fs":0.02542,"n":2,"k":0,"t":"lim xS q ƒ(x) = b or lim"},{"x":0.6505,"y":0.89432,"w":0.10537,"h":0.024,"fs":0.01279,"n":1,"k":0,"t":"xS - q ƒ(x) = b."}]}