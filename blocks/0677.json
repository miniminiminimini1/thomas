286,"w":0.02021,"h":0.01268,"fs":0.01023,"n":1,"k":1,"t":"Δxk"},{"x":0.11492,"y":0.80608,"w":0.12678,"h":0.01279,"fs":0.01023,"n":1,"k":0,"t":"Pk–1 = ( f(tk–1), g(tk–1))"},{"x":0.50409,"y":0.80931,"w":0.29859,"h":0.02475,"fs":0.01279,"n":1,"k":0,"t":"= 23ƒ(tk) - ƒ(tk-1)4 2 + 3g(tk) - g(tk-1)4 2"},{"x":0.09407,"y":0.82501,"w":0.24478,"h":0.01839,"fs":0.01023,"n":2,"k":1,"t":"x 0"},{"x":0.36258,"y":0.84976,"w":0.58812,"h":0.03033,"fs":0.01279,"n":2,"k":1,"t":"(see Figure 11.16). If ∆tk is small, the length Lk is approximately the length of arc Pk-1Pk. By the Mean Value Theorem there are numbers tk"},{"x":0.68622,"y":0.85535,"w":0.20591,"h":0.02475,"fs":0.01279,"n":2,"k":1,"t":"* and tk ** in 3tk-1, tk4 such that"},{"x":0.08775,"y":0.85671,"w":0.23104,"h":0.04297,"fs":0.01151,"n":4,"k":1,"t":"FIGURE 11.16 The arc Pk-1Pk is approximated by the straight-line segment shown here, which has length"},{"x":0.73434,"y":0.8946,"w":0.04193,"h":0.01618,"fs":0.01279,"n":1,"k":1,"t":"*) ∆tk,"},{"x":0.53865,"y":0.8958,"w":0.19476,"h":0.01535,"fs":0.01279,"n":1,"k":1,"t":"∆xk = ƒ(tk) - ƒ(tk-1) = ƒ′(tk"},{"x":0.08868,"y":0.89888,"w":0.14937,"h":0.01784,"fs":0.01151,"n":1,"k":0,"t":"Lk = 2(∆xk)2 + (∆yk)2."},{"x":0.73341,"y":0.92145,"w":0.04748,"h":0.01618,"fs":0.01279,"n":1,"k":0,"t":"**) ∆tk."},{"x":0.53812,"y":0.92265,"w":0.19435,"h":0.01535,"fs":0.01279,"n":1,"k":1,"t":"∆yk = g(tk) - g(tk-1) = g′(tk"}]}