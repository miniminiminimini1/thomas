1279,"n":2,"k":1,"t":"ƒ(x, y, z) ds Eq. (3)"},{"x":0.36913,"y":0.66996,"w":0.0445,"h":0.01433,"fs":0.01279,"n":1,"k":1,"t":"LC1∪C2"},{"x":0.51492,"y":0.66996,"w":0.02183,"h":0.01433,"fs":0.01279,"n":1,"k":1,"t":"LC1"},{"x":0.63804,"y":0.66996,"w":0.02183,"h":0.01433,"fs":0.01279,"n":1,"k":1,"t":"LC2"},{"x":0.52482,"y":0.70705,"w":0.12684,"h":0.02478,"fs":0.01279,"n":2,"k":0,"t":"0 ƒ(t, t, 0)22 dt +"},{"x":0.6693,"y":0.70771,"w":0.1758,"h":0.02411,"fs":0.01279,"n":3,"k":1,"t":"0 ƒ(1, 1, t)(1) dt Eq. (2)"},{"x":0.52482,"y":0.74989,"w":0.16943,"h":0.02925,"fs":0.01401,"n":2,"k":0,"t":"0 (t - 3t2 + 0) 22 dt +"},{"x":0.71188,"y":0.75437,"w":0.13151,"h":0.02478,"fs":0.01279,"n":2,"k":0,"t":"0 (1 - 3 + t)(1) dt"},{"x":0.49755,"y":0.78937,"w":0.06369,"h":0.02323,"fs":0.01279,"n":1,"k":1,"t":"= 22 c t2"},{"x":0.55183,"y":0.78937,"w":0.05943,"h":0.0337,"fs":0.01279,"n":2,"k":1,"t":"2 - t3d 0"},{"x":0.60569,"y":0.78937,"w":0.04921,"h":0.02321,"fs":0.01279,"n":2,"k":1,"t":"1 + c t2"},{"x":0.6455,"y":0.78937,"w":0.06147,"h":0.0337,"fs":0.01279,"n":2,"k":1,"t":"2 - 2td 0"},{"x":0.70141,"y":0.78944,"w":0.06866,"h":0.02248,"fs":0.01279,"n":2,"k":0,"t":"1 = - 22"},{"x":0.75332,"y":0.79262,"w":0.04944,"h":0.02719,"fs":0.01279,"n":2,"k":1,"t":"2 - 3"},{"x":0.79458,"y":0.79982,"w":0.01397,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"2."},{"x":0.32332,"y":0.84585,"w":0.59308,"h":0.08952,"fs":0.01279,"n":6,"k":1,"t":"Notice three things about the integrations in Examples 1 and 2. First, as soon as the components of the appropriate curve were substituted into the formula for ƒ, the integra- tion became a standard integration with respect to t. Second, the integral of ƒ over C1 ∪C2 was obtained by integrating ƒ over each section of the path and adding the results. Third, the integrals of ƒ over C and C1 ∪C2 had different values. We investigate this third obser- vation in Section 16.3."}]}