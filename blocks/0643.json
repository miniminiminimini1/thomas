{"page":643,"blocks":[{"x":0.67565,"y":0.05257,"w":0.27586,"h":0.01535,"fs":0.01535,"n":2,"k":1,"t":"10.8 Taylor and Maclaurin Series 629"},{"x":0.39203,"y":0.09335,"w":0.29555,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"The Taylor polynomial of order n at x = 0 is"},{"x":0.67915,"y":0.11481,"w":0.10347,"h":0.02862,"fs":0.01279,"n":2,"k":0,"t":"2 + g + xn n!."},{"x":0.55654,"y":0.11483,"w":0.1333,"h":0.02292,"fs":0.01279,"n":1,"k":0,"t":"Pn(x) = 1 + x + x2"},{"x":0.36258,"y":0.16011,"w":0.58804,"h":0.02984,"fs":0.01407,"n":2,"k":1,"t":"EXAMPLE 3 Find the Taylor series and Taylor polynomials generated by ƒ(x) = cos x at x = 0."},{"x":0.36258,"y":0.20316,"w":0.29221,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution The cosine and its derivatives are"},{"x":0.50736,"y":0.22252,"w":0.34865,"h":0.04988,"fs":0.01279,"n":10,"k":1,"t":"ƒ(x) = cos x, ƒ′(x) = -sin x, ƒ″(x) = -cos x, ƒ(3)(x) = sin x, f f"},{"x":0.49509,"y":0.27627,"w":0.36117,"h":0.01727,"fs":0.01279,"n":2,"k":1,"t":"ƒ(2n)(x) = (-1)n cos x, ƒ(2n+1)(x) = (-1)n+1 sin x."},{"x":0.36258,"y":0.30309,"w":0.32667,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"At x = 0, the cosines are 1 and the sines are 0, so"},{"x":0.552,"y":0.32491,"w":0.23956,"h":0.01467,"fs":0.01279,"n":2,"k":0,"t":"ƒ(2n)(0) = (-1)n, ƒ(2n+1)(0) = 0."},{"x":0.36258,"y":0.34979,"w":0.25645,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"The Taylor series generated by ƒ at 0 is"},{"x":0.54784,"y":0.3683,"w":0.2283,"h":0.03133,"fs":0.01279,"n":3,"k":0,"t":"2! x2 + ƒ‴(0) 3! x3 + g + ƒ(n)(0)"},{"x":0.422,"y":0.36905,"w":0.14939,"h":0.02296,"fs":0.01279,"n":1,"k":0,"t":"ƒ(0) + ƒ′(0)x + ƒ″(0)"},{"x":0.74928,"y":0.37407,"w":0.09105,"h":0.02555,"fs":0.01279,"n":2,"k":1,"t":"n! xn + g"},{"x":0.52083,"y":0.40348,"w":0.11365,"h":0.02238,"fs":0.01918,"n":1,"k":0,"t":"= 1 + 0 # x - x2"},{"x":0.62107,"y":0.40348,"w":0.10815,"h":0.0294,"fs":0.01918,"n":1,"k":0,"t":"2! + 0 # x3 + x4"},{"x":0.71581,"y":0.40385,"w":0.15066,"h":0.02903,"fs":0.01279,"n":1,"k":0,"t":"4! + g + (-1