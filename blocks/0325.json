:0.01695,"fs":0.01279,"n":1,"k":1,"t":"k + a"},{"x":0.56628,"y":0.43762,"w":0.23112,"h":0.01279,"fs":0.01279,"n":2,"k":1,"t":"4 Sum Rule"},{"x":0.36258,"y":0.43855,"w":0.05008,"h":0.01533,"fs":0.01279,"n":2,"k":1,"t":"(c) a"},{"x":0.39399,"y":0.45172,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.49126,"y":0.45172,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.54513,"y":0.45172,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.47301,"y":0.4574,"w":0.38013,"h":0.03969,"fs":0.01918,"n":3,"k":0,"t":"= (1 + 2 + 3) + (3 # 4) Constant Value Rule = 6 + 12 = 18"},{"x":0.41731,"y":0.50344,"w":0.05993,"h":0.02594,"fs":0.01918,"n":2,"k":0,"t":"1 n = n # 1"},{"x":0.74688,"y":0.50583,"w":0.11269,"h":0.0243,"fs":0.01023,"n":2,"k":1,"t":"Constant Value Rule (1>n is constant)"},{"x":0.46906,"y":0.51175,"w":0.2662,"h":0.01764,"fs":0.01279,"n":1,"k":1,"t":"n = 1"},{"x":0.36258,"y":0.51337,"w":0.05008,"h":0.01533,"fs":0.01279,"n":2,"k":1,"t":"(d) a"},{"x":0.39399,"y":0.52654,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.36258,"y":0.54952,"w":0.59302,"h":0.05883,"fs":0.01279,"n":4,"k":1,"t":"Over the years people have discovered a variety of formulas for the values of finite sums. The most famous of these are the formula for the sum of the first n integers (Gauss is said to have discovered it at age 8) and the formulas for the sums of the squares and cubes of the first n integers."},{"x":0.0992,"y":0.56807,"w":0.1615,"h":0.01023,"fs":0.01023,"n":1,"k":1,"t":"HISTORICAL BIOGRAPHY"},{"x":0.0992,"y":0.58354,"w":0.12145,"h":0.02365,"fs":0.01023,"n":2,"k":1,"t":"Carl Friedrich Gauss (1777–1855)"},{"x":0.36258,"y":0.62455,"w":0.40074,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 4 Show that the sum of the first n integers is"},{"x":0.62041,"y":0.64566,"w":0.0914,"h":0.02278,"fs":0.01279,"n":1,"k":0,"t":"k = n(n + 1)"},{"x":0.67786,"y":0.65568,"w":0.03813,"h":0.01999,"fs":0.01279,"n":2,"k":1,"t":"2 ."},{"x":0.59926,"y":0.66977,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"k":1,"t":"k=1"},{"x":0.36258,"y":0.68423,"w":0.44565,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution The formula tells us that the sum of the first 4 integers is"},{"x":0.61561,"y":0.70645,"w":0.03812,"h":0.01279,"fs":0.01279,"n":1,"k":0,"t":"(4)(5)"},{"x":0.63058,"y":0.7151,"w":0.068,"h":0.02068,"fs":0.01279,"n":2,"k":0,"t":"2 = 10."},{"x":0.36257,"y":0.74136,"w":0.21345,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Addition verifies this prediction:"},{"x":0.5818,"y":0.76369,"w":0.1505,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"1 + 2 + 3 + 4 = 10."},{"x":0.36258,"y":0.78484,"w":0.59289,"h":0.02814,"fs":0.01279,"n":2,"k":1,"t":"To prove the formula in general, we write out the terms in the sum twice, once forward and once backward."},{"x":0.46764,"y":0.82086,"w":0.37477,"h":0.03273,"fs":0.01279,"n":18,"k":0,"t":"1 + 2 + 3 + g + n n + (n - 1) + (n - 2) + g + 1"},{"x":0.36258,"y":0.86089,"w":0.5931,"h":0.07486,"fs":0.01279,"n":5,"k":1,"t":"If we add the two terms in the first column we get 1 + n = n + 1. Similarly, if we add the two terms in the second column we get 2 + (n - 1) = n + 1. The two terms in any column sum to n + 1. When we add the n columns together we get n terms, each equal to n + 1, for a total of n(n + 1). Since this is twice the desired quantity, the sum of the first n integers is (n)(n + 1)>2."}]}