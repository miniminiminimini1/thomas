{"page":497,"blocks":[{"x":0.53643,"y":0.05257,"w":0.41508,"h":0.01535,"fs":0.01535,"n":2,"k":1,"t":"8.5 Integration of Rational Functions by Partial Fractions 483"},{"x":0.36258,"y":0.09345,"w":0.49385,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Then we write the improper fraction as a polynomial plus a proper fraction."},{"x":0.51661,"y":0.11307,"w":0.28089,"h":0.03404,"fs":0.01279,"n":5,"k":0,"t":"2x3 - 4x2 - x - 3 x2 - 2x - 3 = 2x + 5x - 3 x2 - 2x - 3"},{"x":0.36258,"y":0.15612,"w":0.59297,"h":0.02814,"fs":0.01279,"n":2,"k":1,"t":"We found the partial fraction decomposition of the fraction on the right in the opening example, so"},{"x":0.45114,"y":0.18852,"w":0.16773,"h":0.03404,"fs":0.01279,"n":3,"k":0,"t":"2x3 - 4x2 - x - 3 x2 - 2x - 3 dx ="},{"x":0.72082,"y":0.193,"w":0.10505,"h":0.02957,"fs":0.01279,"n":2,"k":0,"t":"5x - 3 x2 - 2x - 3 dx"},{"x":0.64386,"y":0.20019,"w":0.07519,"h":0.0243,"fs":0.01279,"n":2,"k":1,"t":"2x dx + L"},{"x":0.82221,"y":0.2346,"w":0.05935,"h":0.02711,"fs":0.01279,"n":2,"k":0,"t":"3 x - 3 dx"},{"x":0.72082,"y":0.23477,"w":0.07633,"h":0.02703,"fs":0.01279,"n":2,"k":0,"t":"2 x + 1 dx +"},{"x":0.64386,"y":0.24112,"w":0.07519,"h":0.0243,"fs":0.01279,"n":2,"k":1,"t":"2x dx + L"},{"x":0.60895,"y":0.26324,"w":0.27917,"h":0.02588,"fs":0.01353,"n":1,"k":0,"t":"= x2 + 2 ln 0 x + 10 + 3 ln 0 x - 30 + C."},{"x":0.36258,"y":0.31299,"w":0.32898,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 4 Use partial fractions to evaluate"},{"x":0.59648,"y":0.33879,"w":0.1397,"h":0.03004,"fs":0.01401,"n":2,"k":0,"t":"-2x + 4 (x2 + 1)(x - 1)2 dx."},{"x":0.36259,"y":0.38035,"w":0.59302,"h":0.02899,"fs":0.01279,"n":3,"k":1,"t":"Solution The denominator has an irreducible quadratic factor as well as a repeated linear factor, so we write"},{"x":0.48732,"y":0.42064,"w":0.18883,"h":0.02957,"fs":0.01279,"n":2,"k":0,"t":"-2x + 4 (x2 + 1)(x - 1)2 = Ax + B"},{"x":0.6275,"y":0.42123,"w":0.32402,"h":0.02898,"fs":0.01279,"n":6,"k":0,"t":"x2 + 1 + C x - 1 + D (x - 1)2. (2)"},{"x":0.36259,"y":0.45922,"w":0.25787,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Clearing the equation of fractions gives"},{"x":0.4347,"y":0.47708,"w":0.4447,"h":0.01795,"fs":0.01401,"n":1,"k":0,"t":"-2x + 4 = (Ax + B)(x - 1)2 + C(x - 1)(x2 + 1) + D(x2 + 1)"},{"x":0.49852,"y":0.49626,"w":0.26981,"h":0.01795,"fs":0.01279,"n":1,"k":0,"t":"= (A + C)x3 + (-2A + B - C + D)x2"},{"x":0.51342,"y":0.51992,"w":0.24351,"h":0.01347,"fs":0.01279,"n":1,"k":0,"t":"+ (A - 2B + C)x + (B - C + D)."},{"x":0.36258,"y":0.54362,"w":0.26333,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Equating coefficients of like terms gives"},{"x":0.49231,"y":0.56522,"w":0.33028,"h":0.07176,"fs":0.01279,"n":8,"k":0,"t":"Coefficients of x3: 0 = A + C Coefficients of x2: 0 = -2A + B - C + D Coefficients of x1: -2 = A - 2B + C Coefficients of x0: 4 = B - C + D"},{"x":0.36258,"y":0.6472,"w":0.50525,"h":0.01281,"fs":0.01279,"n":1,"k":1,"t":"We solve these equations simultaneously to find the values of A, B, C, and D:"},{"x":0.46156,"y":0.66955,"w":0.41352,"h":0.07102,"fs":0.01279,"n":9,"k":0,"t":"-4 = -2A, A = 2 Subtract fourth equation from second. C = -A = -2 From the first equation B = (A + C + 2)>2 = 1 From the third equation and C = -A D = 4 - B + C = 1. From the fourth equation."},{"x":0.36258,"y":0.75081,"w":0.35725,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"We substitute these values into Equation (2), obtaining"},{"x":0.4891,"y":0.7749,"w":0.18523,"h":0.02957,"fs":0.01279,"n":2,"k":0,"t":"-2x + 4 (x2 + 1)(x - 1)2 = 2x + 1"},{"x":0.6275,"y":0.77574,"w":0.19758,"h":0.02872,"fs":0.01279,"n":5,"k":0,"t":"x2 + 1 - 2 x - 1 + 1 (x - 1)2."},{"x":0.36258,"y":0.81347,"w":0.34145,"h":0.01279,"fs":0.01279,"n":1,"k":1,"t":"Finally, using the expansion above we can integrate:"},{"x":0.5911,"y":0.835,"w":0.0569,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"a2x + 1"},{"x":0.60117,"y":0.835,"w":0.21989,"h":0.03213,"fs":0.01279,"n":5,"k":0,"t":"x2 + 1 - 2 x - 1 + 1 (x - 1)2b dx"},{"x":0.41104,"y":0.83756,"w":0.15343,"h":0.02957,"fs":0.01279,"n":2,"k":0,"t":"-2x + 4 (x2 + 1)(x - 1)2 dx ="},{"x":0.5911,"y":0.87465,"w":0.29798,"h":0.03213,"fs":0.01279,"n":9,"k":0,"t":"a 2x x2 + 1 + 1 x2 + 1 - 2 x - 1 + 1 (x - 1)2b dx"},{"x":0.55481,"y":0.9078,"w":0.36681,"h":0.03309,"fs":0.01353,"n":3,"k":0,"t":"= ln (x2 + 1) + tan-1 x - 2 ln 0 x - 10 - 1 x - 1 + C."}]}