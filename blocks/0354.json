respect to u."},{"x":0.51472,"y":0.49724,"w":0.07829,"h":0.02727,"fs":0.01279,"n":1,"k":0,"t":"= (x3 + x)6"},{"x":0.55832,"y":0.50951,"w":0.22892,"h":0.02229,"fs":0.01279,"n":3,"k":0,"t":"6 + C Substitute x3 + x for u."},{"x":0.32332,"y":0.55938,"w":0.155,"h":0.01449,"fs":0.01407,"n":1,"k":1,"t":"EXAMPLE 2 Find"},{"x":0.50666,"y":0.56041,"w":0.08698,"h":0.01347,"fs":0.01279,"n":1,"k":1,"t":"22x + 1 dx."},{"x":0.32334,"y":0.59476,"w":0.31205,"h":0.01365,"fs":0.01279,"n":2,"k":1,"t":"Solution The integral does not fit the formula"},{"x":0.6083,"y":0.62182,"w":0.03663,"h":0.01728,"fs":0.01279,"n":1,"k":1,"t":"un du,"},{"x":0.32331,"y":0.64657,"w":0.26641,"h":0.02323,"fs":0.01279,"n":1,"k":0,"t":"with u = 2x + 1 and n = 1>2, because"},{"x":0.5534,"y":0.67665,"w":0.05712,"h":0.01999,"fs":0.01279,"n":1,"k":1,"t":"du = du"},{"x":0.59465,"y":0.68318,"w":0.08747,"h":0.02074,"fs":0.01279,"n":1,"k":0,"t":"dx dx = 2 dx"},{"x":0.32331,"y":0.70943,"w":0.59307,"h":0.0435,"fs":0.01279,"n":3,"k":1,"t":"is not precisely dx. The constant factor 2 is missing from the integral. However, we can introduce this factor after the integral sign if we compensate for it by a factor of 1>2 in front of the integral sign. So we write"},{"x":0.442,"y":0.76183,"w":0.23738,"h":0.03776,"fs":0.01918,"n":7,"k":0,"t":"22x + 1 dx = 1 2L 22x + 1 # 2 dx (+)+* ()* u du"},{"x":0.55184,"y":0.80708,"w":0.30695,"h":0.03214,"fs":0.01279,"n":3,"k":0,"t":"2L u1>2 du Let u = 2x + 1, du = 2 dx."},{"x":0.53477,"y":0.80857,"w":0.02526,"h":0.01982,"fs":0.01279,"n":1,"k":1,"t":"= 1"},{"x":0.55143,"y":0.83825,"w":0.03691,"h":0.03571,"fs":0.01279,"n":2,"k":0,"t":"2 u3>2"},{"x":0.53435,"y":0.84694,"w":0.02526,"h":0.01982,"fs":0.01279,"n":1,"k":1,"t":"= 1"},{"x":0.56384,"y":0.85172,"w":0.28365,"h":0.02323,"fs":0.01279,"n":2,"k":1,"t":"3>2 + C Integrate with respect to u."},{"x":0.55143,"y":0.88382,"w":0.2838,"h":0.02843,"fs":0.01279,"n":2,"k":0,"t":"3(2x + 1)3>2 + C Substitute 2x + 1 for u."},{"x":0.53435,"y":0.88531,"w":0.0