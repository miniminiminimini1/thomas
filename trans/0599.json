0.60321,"w":0.07722,"h":0.02365,"fs":0.01023,"n":2,"t":"Blaise Pascal (1623–1662)"},{"x":0.54439,"y":0.61483,"w":0.22529,"h":0.01535,"fs":0.01279,"n":1,"t":"a1 + a2 + a3 + g + an + g"},{"x":0.39285,"y":0.62809,"w":0.52592,"h":0.03858,"fs":0.01279,"n":2,"t":"是无穷级数。数an是级数的第n项。由"},{"x":0.53948,"y":0.66854,"w":0.04928,"h":0.01535,"fs":0.01279,"n":1,"t":"s1 = a1"},{"x":0.53948,"y":0.69156,"w":0.08727,"h":0.01535,"fs":0.01279,"n":1,"t":"s2 = a1 + a2"},{"x":0.53948,"y":0.744,"w":0.21827,"h":0.01695,"fs":0.01279,"n":1,"t":"sn = a1 + a2 + g + an = a"},{"x":0.76232,"y":0.74466,"w":0.01302,"h":0.01432,"fs":0.01279,"n":1,"t":"ak"},{"x":0.73908,"y":0.75878,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"t":"k=1"},{"x":0.39285,"y":0.79823,"w":0.53249,"h":0.04364,"fs":0.01279,"n":3,"t":"定义的部分和序列，数sn是第n个部分和。如果部分和序列收敛到极限L，我们说该级数收敛，其和为L。在这种情况下，我们也写"},{"x":0.51344,"y":0.85782,"w":0.23148,"h":0.01695,"fs":0.01279,"n":1,"t":"a1 + a2 + g + an + g = a"},{"x":0.74949,"y":0.85782,"w":0.05119,"h":0.01535,"fs":0.01279,"n":1,"t":"an = L."},{"x":0.72593,"y":0.87261,"w":0.02065,"h":0.00916,"fs":0.0087,"n":1,"t":"n=1"},{"x":0.39285,"y":0.8892,"w":0.53777,"h":0.02814,"fs":0.01279,"n":2,"t":"如果级数的部分和序列不收敛，我们说该级数发散。"}]}