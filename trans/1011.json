,"h":0.01093,"fs":0.01023,"n":2,"t":"1 1"},{"x":0.39797,"y":0.456,"w":0.33378,"h":0.02067,"fs":0.01279,"n":2,"t":"r(u, y) = cos u cos yi + cos u sin yj + uk, -π … u … π, 0 … y … 2π."},{"x":0.72192,"y":0.456,"w":0.19423,"h":0.02787,"fs":0.01279,"n":3,"t":"2 −"},{"x":0.21128,"y":0.49145,"w":0.01925,"h":0.01686,"fs":0.01023,"n":2,"t":"接下来我们使用方程 (5) 来找到 S 的表面积。参数化的微分给出"},{"x":0.36259,"y":0.50223,"w":0.58901,"h":0.02815,"fs":0.01279,"n":2,"t":"图 16.43 通过绕 z 轴旋转曲线 x = cos z 得到的“足球”表面，示例 6。"},{"x":0.08775,"y":0.53474,"w":0.24736,"h":0.04298,"fs":0.01151,"n":4,"t":""},{"x":0.52684,"y":0.54505,"w":0.2604,"h":0.01535,"fs":0.01279,"n":1,"t":"ru = -sin u cos y i - sin u sin y j + k"},{"x":0.36258,"y":0.57642,"w":0.02362,"h":0.01279,"fs":0.01279,"n":1,"t":"和"},{"x":0.53865,"y":0.60388,"w":0.23681,"h":0.01535,"fs":0.01279,"n":1,"t":"ry = -cos u sin y i + cos u cos y j."},{"x":0.36258,"y":0.63525,"w":0.24706,"h":0.01279,"fs":0.01279,"n":1,"t":"计算叉积，我们得到"},{"x":0.37322,"y":0.65313,"w":0.0767,"h":0.04667,"fs":0.01279,"n":1,"t":"ru * ry = 3"},{"x":0.45312,"y":0.6672,"w":0.20807,"h":0.04862,"fs":0.01279,"n":9,"t":"i j k -sin u cos y -sin u sin y 1 -cos u sin y cos u cos y 0"},{"x":0.42966,"y":0.72473,"w":0.51028,"h":0.01795,"fs":0.01279,"n":1,"t":"= -cos u cos y i - cos u sin y j - (sin u cos u cos2 y + cos u sin u sin2 y)k."},{"x":0.36258,"y":0.75675,"w":0.31382,"h":0.01279,"fs":0.01279,"n":1,"t":"取叉积的模长，我们得到"},{"x":0.47873,"y":0.77179,"w":0.35913,"h":0.02776,"fs":0.01353,"n":1,"t":"0 ru * ry0 = 2cos2 u (cos2 y + sin2 y) + sin2 u cos2 u"},{"x":0.54335,"y":0.80725,"w":0.161,"h":0.01759,"fs":0.01401,"n":1,"t":"= 2cos2 u (1 + sin2 u)"},{"x":0.54335,"y":0.83366,"w":0.27463,"h":0.01773,"fs":0.01279,"n":2,"t":"= cos u 21 + sin2 u. cos u Ú 0 for -p"},{"x":0.81013,"y":0.83366,"w":0.06473,"h":0.02329,"fs":0.01023,"n":2,"t":"2 … u … p 2"},{"x":0.36258,"y":0.86929,"w":0.38148,"h":0.01279,"fs":0.01279,"n":1,"t":"从方程（4）可得表面积由以下积分给出"},{"x":0.60274,"y":0.88723,"w":0.01871,"h":0.01626,"fs":0.00895,"