,"w":0.59303,"h":0.02984,"fs":0.01407,"n":2,"t":"例6 一个流体的速度场是 F = xi + zj + yk。求沿螺旋线 r(t) = (cos t)i + (sin t)j + tk，0 ≤ t ≤ π/2 的流量。"},{"x":0.32331,"y":0.63958,"w":0.25751,"h":0.01365,"fs":0.01279,"n":2,"t":"解 我们在曲线上评估 F，"},{"x":0.35079,"y":0.66277,"w":0.53401,"h":0.01347,"fs":0.01279,"n":2,"t":"F = xi + zj + yk = (cos t)i + tj + (sin t)k Substitute x = cos t, z = t, y = sin t."},{"x":0.32332,"y":0.67604,"w":0.13345,"h":0.02323,"fs":0.01279,"n":1,"t":"然后找到 dr/dt："},{"x":0.51646,"y":0.71506,"w":0.01543,"h":0.0128,"fs":0.01279,"n":1,"t":"dr"},{"x":0.51782,"y":0.7216,"w":0.20137,"h":0.02074,"fs":0.01279,"n":1,"t":"dt = (-sin t)i + (cos t)j + k."},{"x":0.32332,"y":0.75021,"w":0.33304,"h":0.02383,"fs":0.01918,"n":1,"t":"然后我们积分 F # (dr/dt) 从 t = 0 到 t = π/2："},{"x":0.64654,"y":0.76065,"w":0.01651,"h":0.01999,"fs":0.01279,"n":1,"t":"F # dr"},{"x":0.45977,"y":0.78491,"w":0.03846,"h":0.02238,"fs":0.01918,"n":1,"t":"dt = (cos t)(-sin t) + (t)(cos t) + (sin t)(1)"},{"x":0.48416,"y":0.79322,"w":0.29243,"h":0.02074,"fs":0.01279,"n":1,"t":"= -sin t cos t + t cos t + sin t."},{"x":0.50563,"y":0.81752,"w":0.20971,"h":0.01347,"fs":0.01279,"n":1,"t":"所以，"},{"x":0.32332,"y":0.84122,"w":0.02136,"h":0.01279,"fs":0.01279,"n":1,"t":"π/2"},{"x":0.59383,"y":0.85277,"w":0.01871,"h":0.01626,"fs":0.00895,"n":1,"t":"t=b"},{"x":0.47828,"y":0.8596,"w":0.01862,"h":0.00942,"fs":0.00895,"n":1,"t":"F # dr"},{"x":0.49902,"y":0.8642,"w":0.03845,"h":0.02238,"fs":0.01918,"n":1,"t":"流量 ="},{"x":0.39857,"y":0.87251,"w":0.05469,"h":0.01347,"fs":0.01279,"n":1,"t":"dt dt ="},{"x":0.52325,"y":0.87251,"w":0.04558,"h":0.02074,"fs":0.01279,"n":1,"t":"0 (-sin t cos t + t cos t + sin t) dt"},{"x":0.58647,"y":0.87251,"w":0.24451,"h":0.02478,"fs":0.01279,"n":2,"t":"t=a"},{"x":0.47091,"y":0.88786,"w":0.01862,"h":0.00942,"fs":0.00895,"n":1,"t":"π/2"},{"x":0.57496,"y":0.89793,"w":0.01813,"h":0.0158,"fs":0.0087,"n":1,"t":"F # dr"},{"x":0.44361,"y":0.90371,"w":0.06132,"h":0.02448,"fs":0.01279,"n":1,"t":"dt dt ="},{"x":0.48301,"y":0.90496,"w":0.08949,"h":0.03044,"fs":0.01279,"n":2,"t":"c cos^2 t"},{"x":0.60043,"y":0.90496,"w":0.07156,"h":0.02323,"fs":0.01279,"n":1,"t":"2 + t sin t dt"},{"x":0.66217,"y":0.90496,"w":0.18096,"h":0.03044,"fs":0.01279,"n":4,"t":"= a0 + π/2 b - a1^2 + 0b = π^2/2 - 1/2."}]}