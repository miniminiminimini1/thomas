12637,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲正切："},{"x":0.54095,"y":0.27076,"w":0.11737,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲余弦："},{"x":0.35071,"y":0.27084,"w":0.10347,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲正弦："},{"x":0.77748,"y":0.2784,"w":0.10893,"h":0.02969,"fs":0.01151,"n":1,"t":"cosh x = e^x - e^(-x)"},{"x":0.54178,"y":0.27857,"w":0.10884,"h":0.02291,"fs":0.01151,"n":1,"t":"cosh x = e^x + e^(-x)"},{"x":0.35153,"y":0.28249,"w":0.10644,"h":0.0229,"fs":0.01151,"n":1,"t":"sinh x = e^x - e^(-x)"},{"x":0.72009,"y":0.28302,"w":0.0933,"h":0.01828,"fs":0.01151,"n":1,"t":"tanh x = sinh x"},{"x":0.83663,"y":0.29154,"w":0.04978,"h":0.01614,"fs":0.01151,"n":1,"t":"e^x + e^(-x)"},{"x":0.71926,"y":0.32046,"w":0.14027,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲余切："},{"x":0.77869,"y":0.32827,"w":0.11008,"h":0.02969,"fs":0.01151,"n":1,"t":"sinh x = e^x + e^(-x)"},{"x":0.72009,"y":0.3329,"w":0.09451,"h":0.01828,"fs":0.01151,"n":1,"t":"coth x = cosh x"},{"x":0.83777,"y":0.34142,"w":0.04978,"h":0.01614,"fs":0.01151,"n":1,"t":"e^x - e^(-x)"},{"x":0.59462,"y":0.36341,"w":0.00654,"h":0.02541,"fs":0.01023,"n":2,"t":"2 1"},{"x":0.06812,"y":0.36562,"w":0.17632,"h":0.02814,"fs":0.01279,"n":2,"t":"表7.5 双曲函数的恒等式"},{"x":0.435,"y":0.37052,"w":0.0298,"h":0.01078,"fs":0.01023,"n":1,"t":"y = 1"},{"x":0.06894,"y":0.39953,"w":0.14695,"h":0.01728,"fs":0.01279,"n":1,"t":"cosh^2 x - sinh^2 x = 1"},{"x":0.35579,"y":0.39957,"w":0.09281,"h":0.01078,"fs":0.01023,"n":4,"t":"1 -1 0 2 -2"},{"x":0.55432,"y":0.39958,"w":0.09229,"h":0.01078,"fs":0.01023,"n":4,"t":"1 -1 2 -2"},{"x":0.58372,"y":0.40778,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"-1"},{"x":0.41796,"y":0.41005,"w":0.05559,"h":0.01078,"fs":0.01023,"n":1,"t":"y = sech x"},{"x":0.61678,"y":0.41368,"w":0.05559,"h":0.01078,"fs":0.01023,"n":1,"t":"y = csch x"},{"x":0.06894,"y":0.42425,"w":0.16717,"h":0.01347,"fs":0.01279,"n":1,"t":"sinh 2x = 2 sinh x cosh x"},{"x":0.06894,"y":0.44603,"w":0.18425,"h":0.01421,"fs":0.01279,"n":1,"t":"cosh 2x = cosh^2 x + sinh^2 x"},{"x":0.39923,"y":0.448,"w":0.01591,"h":0.01023,"fs":0.01023,"n":1,"t":"(d)"},{"x":0.59794,"y":0.44801,"w":0.01453,"h":0.01023,"fs":0.01023,"n":1,"t":"(e)"},{"x":0.35005,"y":0.46476,"w":0.11818,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲正割："},{"x":0.54713,"y":0.46489,"w":0.13208,"h":0.01151,"fs":0.01151,"n":1,"t":"双曲余割："},{"x":0.06894,"y":0.46768,"w":0.1508,"h":0.02067,"fs":0.01279,"n":1,"t":"cosh^2 x = cosh 2x + 1"},{"x":0.35088,"y":0.47738,"w":0.16716,"h":0.02489,"fs":0.01151,"n":5,"t":"sech x = 1/cosh x = 2(e^x + e^(-x))"},{"x":0.54795,"y":0.48135,"w":0.17954,"h":0.02489,"fs":0.01151,"n":5,"t":"csch x = 1/sinh x = 2(e^x - e^(-x))"},{"x":0.06894,"y":0.49578,"w":0.14808,"h":0.02067,"fs":0.01279,"n":1,"t":"sinh^2 x = cosh 2x - 1"},{"x":0.06894,"y":0.51087,"w":0.14289,"h":0.0281,"fs":0.01279,"n":2,"t":"2 tanh^2 x = 1 - sech^2 x"},{"x":0.06894,"y":0.54792,"w":0.14289,"h":0.01421,"fs":0.01279,"n":1,"t":"coth^2 x = 1 + csch^2 x"},{"x":0.32332,"y":0.55475,"w":0.59302,"h":0.05883,"fs":0.01279,"n":4,"t":"其他恒等式可以通过将双曲函数的定义代入并使用代数方法得到。像许多标准函数一样，双曲函数及其反函数可以用计算器轻松计算，计算器通常有专门的按键用于此目的。"},{"x":0.32332,"y":0.61612,"w":0.59294,"h":0.0435,"fs":0.01279,"n":3,"t":"对于任何实数u，我们知道坐标为(cos u, sin u)的点位于单位圆x^2 + y^2 = 1上。因此，三角函数有时被称为圆函数。由于第一个恒等式"},{"x":0.54406,"y":0.66843,"w":0.14746,"h":0.01421,"fs":0.01279,"n":1,"t":"cosh^2 u - sinh^2 u = 1，"},{"x":0.06746,"y":0.67004,"w":0.18052,"h":0.02814,"fs":0.01279,"n":2,"t":"表7.6 双曲函数的导数"},{"x":0.32332,"y":0.69285,"w":0.59309,"h":0.0435,"fs":0.01279,"n":3,"t":"将x替换为u在表7.5中，坐标为(cosh u, sinh u)的点位于双曲线x^2 - y^2 = 1的右支上。这就是双曲函数得名的地方（参见练习86）。"},{"x":0.06836,"y":0.71065,"w":0.15509,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (sinh u) = cosh u du"},{"x":0.20753,"y":0.72513,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.32332,"y":0.73891,"w":0.59317,"h":0.10487,"fs":0.01279,"n":7,"t":"双曲函数在求积分中很有用，我们将在第8章中看到。它们在科学和工程中也起着重要的作用。双曲余弦描述了悬挂在两个同高度点之间并自由悬挂的绳索或线的形状（参见练习83）。圣路易斯大拱的形状是一个倒置的双曲余弦。双曲正切出现在恒定深度水面上移动的海洋波浪速度公式中，而双曲正切的反函数描述了根据狭义相对论中的爱因斯坦定律，相对速度如何相加。"},{"x":0.06836,"y":0.74707,"w":0.15509,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (cosh u) = sinh u du"},{"x":0.20753,"y":0.76155,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.06836,"y":0.78348,"w":0.15813,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (tanh u) = sech^2 u du"},{"x":0.21057,"y":0.79797,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.06836,"y":0.8199,"w":0.1694,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (coth u) = -csch^2 u du"},{"x":0.22184,"y":0.83439,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.06836,"y":0.85632,"w":0.2096,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (sech u) = -sech u tanh u du"},{"x":0.32332,"y":0.86772,"w":0.37659,"h":0.01375,"fs":0.01375,"n":1,"t":"双曲函数的导数与积分"},{"x":0.26204,"y":0.8708,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.32332,"y":0.89238,"w":0.59299,"h":0.04348,"fs":0.01279,"n":3,"t":"六个双曲函数，作为可微函数e^x和e^(-x)的有理组合，在它们定义的每个点都有导数（见表7.6）。再次，这与三角函数有相似之处。"},{"x":0.06836,"y":0.89274,"w":0.2096,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (csch u) = -csch u coth u du"},{"x":0.26204,"y":0.90722,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"}]}