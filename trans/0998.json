x":0.75564,"y":0.78487,"w":0.06537,"h":0.02985,"fs":0.01279,"n":1,"t":"0y ∆yb ∆x"},{"x":0.39041,"y":0.82707,"w":0.38865,"h":0.02323,"fs":0.01279,"n":2,"t":"右侧和左侧：(M(x + ∆x, y) - M(x, y))∆y ≈a0M"},{"x":0.76244,"y":0.82707,"w":0.07079,"h":0.02985,"fs":0.01279,"n":1,"t":"0x ∆xb ∆y."},{"x":0.32334,"y":0.87844,"w":0.49223,"h":0.01279,"fs":0.01279,"n":1,"t":"将这两个最后方程相加给出流量的净效应，或者说"},{"x":0.4373,"y":0.90637,"w":0.26444,"h":0.02323,"fs":0.01279,"n":1,"t":"矩形边界通量 ≈a0M"},{"x":0.68512,"y":0.90637,"w":0.11239,"h":0.02985,"fs":0.01279,"n":2,"t":"0x + 0N 0y b ∆x∆y."}]}