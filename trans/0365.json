39237,"w":0.59288,"h":0.05969,"fs":0.01279,"n":5,"t":"解草图（图5.29）显示该区域的边界是f(x) = 2x的图形。下边界从0 ≤ x ≤ 2时的g(x) = 0变为2 ≤ x ≤ 4时的g(x) = x - 2（两个公式在x = 2时一致）。我们在x = 2处将区域划分为子区域A和B，如图5.29所示。"},{"x":0.36258,"y":0.45393,"w":0.59302,"h":0.02882,"fs":0.01279,"n":2,"t":"区域A的积分上下限是a = 0和b = 2。区域B的左端点是a = 2。为了找到右端点，我们解方程y = 2x和"},{"x":0.17398,"y":0.45801,"w":0.10529,"h":0.02122,"fs":0.01369,"n":2,"t":"∫[2(x - x + 2) dx = L]"},{"x":0.13686,"y":0.45831,"w":0.0396,"h":0.01078,"fs":0.01023,"n":1,"t":"面积 ="},{"x":0.2519,"y":0.48449,"w":0.0424,"h":0.0115,"fs":0.01023,"n":1,"t":"y = √x"},{"x":0.36392,"y":0.48462,"w":0.21437,"h":0.01347,"fs":0.01279,"n":1,"t":"y = x - 2 同时对于x："},{"x":0.11158,"y":0.49603,"w":0.21438,"h":0.01618,"fs":0.01023,"n":2,"t":"(4, 2) 面积 ="},{"x":0.2142,"y":0.49621,"w":0.04153,"h":0.01024,"fs":0.01023,"n":1,"t":"(x, f(x))"},{"x":0.15561,"y":0.49653,"w":0.04148,"h":0.01971,"fs":0.01023,"n":2,"t":"0 √x dx"},{"x":0.51178,"y":0.51532,"w":0.43769,"h":0.09021,"fs":0.01279,"n":11,"t":"2x = x - 2 将f(x)和g(x)相等。x = (x - 2)^2 = x^2 - 4x + 4 两边平方。x^2 - 5x + 4 = 0 重写。(x - 1)(x - 4) = 0 因式分解。x = 1, x = 4. 解。"},{"x":0.10604,"y":0.52059,"w":0.04153,"h":0.01024,"fs":0.01023,"n":1,"t":"(x, f(x))"},{"x":0.26997,"y":0.52854,"w":0.05306,"h":0.01078,"fs":0.01023,"n":1,"t":"y = x - 2"},{"x":0.23083,"y":0.55482,"w":0.04312,"h":0.01024,"fs":0.01023,"n":1,"t":"(x, g(x))"},{"x":0.15504,"y":0.57818,"w":0.0298,"h":0.01078,"fs":0.01023,"n":1,"t":"y = 0"},{"x":0.19596,"y":0.57943,"w":0.10516,"h":0.01023,"fs":0.01023,"n":2,"t":"4 2"},{"x":0.111,"y":0.59342,"w":0.04312,"h":0.01024,"fs":0.01023,"n":1,"t":"(x, g(x))"},{"x":0.08775,"y":0.61887,"w":0.25107,"h":0.07365,"fs":0.01151,"n":6,"t":"图5.29 当边界曲线的公式发生变化时，面积积分变为匹配的积分之和，每个阴影区域对应一个积分，例如例子6中的。"},{"x":0.36258,"y":0.62274,"w":0.58894,"h":0.02882,"fs":0.01279,"n":2,"t":"只有x = 4满足方程2x = x - 2。x = 1是平方引入的额外根。右端点是b = 4。"},{"x":0.43211,"y":0.66878,"w":0.34523,"h":0.01347,"fs":0.01279,"n":2,"t":"对于0 ≤ x ≤ 2：f(x) - g(x) = 2x - 0 = 2x"},{"x":0.43211,"y":0.6918,"w":0.45177,"h":0.01347,"fs":0.01279,"n":2,"t":"对于2 ≤ x ≤ 4：f(x) - g(x) = 2x - (x - 2) = 2x - x + 2"},{"x":0.36258,"y":0.72316,"w":0.39928,"h":0.01281,"fs":0.01279,"n":1,"t":"我们将子区域A和B的面积相加以找到总面积："},{"x":0.63862,"y":0.75338,"w":0.13718,"h":0.03993,"fs":0.01441,"n":2,"t":"∫[2x - x + 2] dx"},{"x":0.4452,"y":0.76854,"w":0.08255,"h":0.01347,"fs":0.01279,"n":1,"t":"总面积 ="},{"x":0.54702,"y":0.76854,"w":0.09727,"h":0.02478,"fs":0.01279,"n":3,"t":"0 2x dx + L"},{"x":0.5319,"y":0.78977,"w":0.244,"h":0.02357,"fs":0.01023,"n":4,"t":"[++]++* [+++++]+++++* A区域的面积 B区域的面积"},{"x":0.50818,"y":0.82145,"w":0.03385,"h":0.02323,"fs":0.01279,"n":1,"t":"= c 2"},{"x":0.53385,"y":0.82145,"w":0.04886,"h":0.0337,"fs":0.01279,"n":2,"t":"∫[x^3 > 2] d 0"},{"x":0.57715,"y":0.82145,"w":0.04676,"h":0.02323,"fs":0.01279,"n":2,"t":"2 + c 2"},{"x":0.61572,"y":0.82145,"w":0.12631,"h":0.0337,"fs":0.01279,"n":3,"t":"∫[x^3 > 2 - x^2/2 + 2x] d 2"},{"x":0.52526,"y":0.86493,"w":0.38783,"h":0.03035,"fs":0.01279,"n":3,"t":"∫[x^3 > 2 - 0 + a^2] d 2 - ∫[x^3 > 8 - 2 + 8b - a^2] d 2 - ∫[x^3 > 2 - 2 + 4b] d 2"},{"x":0.50818,"y":0.86834,"w":0.02526,"h":0.01982,"fs":0.01279,"n":1,"t":"= 2"},{"x":0.52526,"y":0.90654,"w":0.1085,"h":0.02711,"fs":0.01279,"n":2,"t":"∫[8 - 2 = 10] d ."},{"x":0.50818,"y":0.9067,"w":0.02526,"h":0.01982,"fs":0.01279,"n":1,"t":"= 2"}]}