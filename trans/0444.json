fs":0.01279,"n":2,"t":"微分方程：dy"},{"x":0.62535,"y":0.82592,"w":0.28692,"h":0.02074,"fs":0.01279,"n":2,"t":"dt = ky (1a)"},{"x":0.48038,"y":0.85405,"w":0.43187,"h":0.01499,"fs":0.01279,"n":5,"t":"初始条件：当 t = 0 时，y = y0。（1b）"},{"x":0.32332,"y":0.87714,"w":0.593,"h":0.05885,"fs":0.01279,"n":4,"t":"如果 y 是正值且在增加，那么 k 是正值，我们使用方程（1a）来说明增长速率与已经积累的量成正比。如果 y 是正值且在减少，那么 k 是负值，我们使用方程（1a）来说明衰减速率与剩余的量成正比。"}]}