79,"n":2,"t":"接下来，因为F′(a) = F′(c1) = 0，且F′和F″在( a, c1)上都是连续的，我们知道"},{"x":0.49647,"y":0.59017,"w":0.24264,"h":0.01603,"fs":0.01279,"n":2,"t":"F″(c2) = 0，对于某个c2∈(a, c1)。"},{"x":0.32332,"y":0.61583,"w":0.55946,"h":0.01467,"fs":0.01279,"n":1,"t":"将罗尔定理依次应用于F″，F‴，...，F(n-1)，意味着存在"},{"x":0.49427,"y":0.64516,"w":0.26096,"h":0.01499,"fs":0.01279,"n":3,"t":"c3∈(a, c2)，使得F‴(c3) = 0，"},{"x":0.49427,"y":0.66745,"w":0.26607,"h":0.01573,"fs":0.01279,"n":3,"t":"c4∈(a, c3)，使得F(4)(c4) = 0，"},{"x":0.49427,"y":0.71348,"w":0.2664,"h":0.01574,"fs":0.01279,"n":3,"t":"cn∈(a, cn-1)，使得F(n)(cn) = 0。"},{"x":0.32331,"y":0.7326,"w":0.59302,"h":0.02474,"fs":0.01279,"n":1,"t":"最后，因为F(n)在( a, cn)上连续且可导，且"},{"x":0.32331,"y":0.75696,"w":0.59302,"h":0.02957,"fs":0.01279,"n":2,"t":"F(n)(a) = F(n)(cn) = 0，罗尔定理意味着存在一个数cn+1∈(a, cn)，使得"},{"x":0.57443,"y":0.79487,"w":0.33782,"h":0.01619,"fs":0.01279,"n":2,"t":"F(n+1)(cn+1) = 0. (7)"},{"x":0.32332,"y":0.82173,"w":0.56407,"h":0.01618,"fs":0.01279,"n":1,"t":"如果我们对F(x) = ƒ(x) - Pn(x) - K(x - a)n+1求导n+1次，我们得到"},{"x":0.50081,"y":0.84859,"w":0.41144,"h":0.01467,"fs":0.01279,"n":2,"t":"F(n+1)(x) = ƒ(n+1)(x) - 0 - (n + 1)!K. (8)"},{"x":0.32332,"y":0.87733,"w":0.22878,"h":0.01279,"fs":0.01279,"n":1,"t":"方程(7)和(8)一起给出"},{"x":0.45174,"y":0.90432,"w":0.09096,"h":0.02416,"fs":0.01279,"n":1,"t":"K = ƒ(n+1)(c)"},{"x":0.48707,"y":0.91501,"w":0.42517,"h":0.02109,"fs":0.01279,"n":3,"t":"(n + 1)!，对于某个数c = cn+1∈(a, b). (9)"}]}