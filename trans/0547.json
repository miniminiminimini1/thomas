.0128,"fs":0.01151,"n":1,"t":"e2x cos x dx"},{"x":0.78918,"y":0.48683,"w":0.07414,"h":0.01024,"fs":0.01023,"n":1,"t":"P(cos x, sin x)"},{"x":0.08775,"y":0.50916,"w":0.41148,"h":0.0128,"fs":0.01151,"n":1,"t":"我们像之前一样，从列出 e2x 的连续导数开始"},{"x":0.08775,"y":0.5245,"w":0.12921,"h":0.01153,"fs":0.01151,"n":1,"t":"以及 cos x 的积分："},{"x":0.76622,"y":0.52469,"w":0.0492,"h":0.02277,"fs":0.01023,"n":2,"t":"sin x x"},{"x":0.70506,"y":0.53245,"w":0.00654,"h":0.02154,"fs":0.01023,"n":2,"t":"2 x"},{"x":0.68873,"y":0.56237,"w":0.08761,"h":0.01229,"fs":0.01023,"n":3,"t":"cos x 1 0"},{"x":0.08775,"y":0.56279,"w":0.23456,"h":0.02693,"fs":0.01215,"n":6,"t":"e2x 及其 cos x 及其导数 积分"},{"x":0.11419,"y":0.59997,"w":0.18479,"h":0.0128,"fs":0.01151,"n":3,"t":"e2x (+) cos x"},{"x":0.11052,"y":0.62043,"w":0.18723,"h":0.0128,"fs":0.01151,"n":3,"t":"2e2x (-) sin x"},{"x":0.53926,"y":0.63451,"w":0.14064,"h":0.01151,"fs":0.01151,"n":1,"t":"我们可以读取这个关系"},{"x":0.11052,"y":0.64089,"w":0.3791,"h":0.01503,"fs":0.01151,"n":4,"t":"4e2x (+) -cos x d 停止在这里：行与"},{"x":0.68775,"y":0.65332,"w":0.0286,"h":0.01827,"fs":0.01151,"n":1,"t":"tan x"},{"x":0.70939,"y":0.65332,"w":0.09365,"h":0.02498,"fs":0.01151,"n":3,"t":"2 = sin x 1 + cos x."},{"x":0.34786,"y":0.65848,"w":0.15012,"h":0.03581,"fs":0.01023,"n":3,"t":"第一行除了乘法常数（左边是4，右边是-1）外。"},{"x":0.5687,"y":0.68566,"w":0.28827,"h":0.01151,"fs":0.01151,"n":1,"t":"为了看到替换的效果，我们进行计算。"},{"x":0.6157,"y":0.70165,"w":0.10711,"h":0.02494,"fs":0.01151,"n":1,"t":"cos x = 2 cos2 ax"},{"x":0.71585,"y":0.70568,"w":0.15696,"h":0.02919,"fs":0.01151,"n":3,"t":"2b - 1 = 2 sec2 (x>2) - 1"},{"x":0.08775,"y":0.71252,"w":0.41599,"h":0.03964,"fs":0.01151,"n":3,"t":"一旦我们达到与第一行相同（除了乘法常数外），我们就停止求导和积分。我们将表格解释为"},{"x":0.65205,"y":0.74302,"w":0.22386,"h":0.02638,"fs":0.01151,"n":5,"t":"= 2 1 + tan2 (x>2) - 1 = 2 1 + z2 - 1"},{"x":0.16589,"y":0.77518,"w":0.26612,"h":0.01308,"fs":0.01261,"n":1,"t":"e2x cos x dx = +(e2x sin x) - (2e2x(-cos x))"},{"x":0.61533,"y":0.77793,"w":0.09193,"h":0.02027,"fs":0.01151,