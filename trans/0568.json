:"min."},{"x":0.32332,"y":0.70526,"w":0.37534,"h":0.01279,"fs":0.01279,"n":1,"t":"描述混合过程的微分方程是"},{"x":0.50795,"y":0.73396,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dy"},{"x":0.50931,"y":0.73396,"w":0.2192,"h":0.02983,"fs":0.01279,"n":4,"t":"dt = 80 - 45y 2000 - 5t Eq. (8)"},{"x":0.32332,"y":0.77432,"w":0.14268,"h":0.01279,"fs":0.01279,"n":1,"t":"以磅/分钟计。"},{"x":0.35277,"y":0.78967,"w":0.48614,"h":0.01279,"fs":0.01279,"n":1,"t":"为了解这个微分方程，我们首先将其写成标准线性形式："},{"x":0.53495,"y":0.8107,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dy"},{"x":0.53631,"y":0.81316,"w":0.1644,"h":0.02736,"fs":0.01279,"n":3,"t":"dt + 45 2000 - 5t y = 80."},{"x":0.32332,"y":0.84062,"w":0.46461,"h":0.02323,"fs":0.01279,"n":1,"t":"因此，P(t) = 45/(2000 - 5t) 和 Q(t) = 80。积分因子是"},{"x":0.45665,"y":0.87659,"w":0.12294,"h":0.01795,"fs":0.01279,"n":1,"t":"y(t) = e^(∫ P dt) = e^(∫"},{"x":0.58127,"y":0.87724,"w":0.04152,"h":0.01473,"fs":0.0087,"n":2,"t":"45/(2000 - 5t) dt)"},{"x":0.54752,"y":0.90161,"w":0.23085,"h":0.03386,"fs":0.01279,"n":3,"t":"= e^(-9 ∫ ln(2000-5t)/(2000 - 5t) dt) 2000 - 5t 7 0 = (2000 - 5t)^(-9)."}]}