"},{"x":0.36258,"y":0.55618,"w":0.59303,"h":0.02882,"fs":0.01279,"n":2,"t":"y = 12,000是一个常数。一般情况和视线角u在图3.48中给出。我们想要找到当u = p>6弧度和du/dt = 2>3度/秒时的dx/dt。"},{"x":0.39203,"y":0.58756,"w":0.19584,"h":0.01279,"fs":0.01279,"n":1,"t":"从图3.48中，我们看到"},{"x":0.5092,"y":0.61036,"w":0.29578,"h":0.02595,"fs":0.01279,"n":5,"t":"12,000 x = tan u 或 x = 12,000 cot u."},{"x":0.36258,"y":0.64741,"w":0.51616,"h":0.01279,"fs":0.01279,"n":1,"t":"使用英里而不是英尺作为我们的距离单位，最后一个方程转换为"},{"x":0.59892,"y":0.66957,"w":0.07659,"h":0.02171,"fs":0.01279,"n":1,"t":"x = 12,000"},{"x":0.63672,"y":0.67781,"w":0.07887,"h":0.02084,"fs":0.01279,"n":1,"t":"5280 cot u."},{"x":0.36257,"y":0.70917,"w":0.24383,"h":0.01281,"fs":0.01279,"n":1,"t":"对t求导给出"},{"x":0.63798,"y":0.73102,"w":0.09558,"h":0.02812,"fs":0.01279,"n":2,"t":"528 csc²u du/dt ."},{"x":0.58062,"y":0.73177,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.58198,"y":0.73178,"w":0.08458,"h":0.02726,"fs":0.01279,"n":1,"t":"dt = - 1200"},{"x":0.36258,"y":0.75923,"w":0.58893,"h":0.03858,"fs":0.01279,"n":2,"t":"当 u = p>6 时，sin²u = 1>4，所以 csc²u = 4。将 du/dt = 2/3 度/秒转换为弧度/小时，我们得到"},{"x":0.48564,"y":0.80566,"w":0.38339,"h":0.03044,"fs":0.01279,"n":3,"t":"3 a p 180b(3600) rad/hr. 1 hr = 3600 sec, 1 deg = p/180 rad"},{"x":0.4451,"y":0.80814,"w":0.01602,"h":0.01346,"fs":0.01279,"n":1,"t":"du"},{"x":0.44677,"y":0.80906,"w":0.04705,"h":0.0271,"fs":0.01279,"n":1,"t":"dt = 2"},{"x":0.36258,"y":0.83635,"w":0.32954,"h":0.02323,"fs":0.01279,"n":1,"t":"将此代入 dx/dt 的方程中，然后得到"},{"x":0.502,"y":0.86615,"w":0.0951,"h":0.0305,"fs":0.01279,"n":1,"t":"dt = a - 1200"},{"x":0.56851,"y":0.86615,"w":0.24502,"h":0.0306,"fs":0.01279,"n":3,"t":"528 b(4)a^2 3b a p 180b(3600) ≈-380."},{"x":0.50064,"y":0.86937,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"},{"x":0.36258,"y":0.90727,"w":0.58884,"h":0.02815,"fs":0.01279,"n":2,"t":"负号出现是因为距离x在减小，所以当雷达首次探测到飞机时，飞机正以大约380英里/小时的速度接近岛屿。"}]}