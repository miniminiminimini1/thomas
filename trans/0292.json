w":0.13333,"h":0.08776,"fs":0.02542,"n":2,"t":"2x - r，其中 x 大于或等于 r"},{"x":0.35276,"y":0.78014,"w":0.39092,"h":0.01427,"fs":0.01279,"n":1,"t":"牛顿法并不总是收敛。例如，如果"},{"x":0.09505,"y":0.78199,"w":0.01309,"h":0.01142,"fs":0.01023,"n":1,"t":"10"},{"x":0.05969,"y":0.7882,"w":0.21764,"h":0.09208,"fs":0.01023,"n":5,"t":"x1 x2 x0 -1 \"3 1 \"3"},{"x":0.13696,"y":0.80485,"w":0.07397,"h":0.01342,"fs":0.01023,"n":1,"t":"B1(2.12, 6.35)"},{"x":0.13078,"y":0.82374,"w":0.06363,"h":0.01142,"fs":0.01023,"n":1,"t":"求根"},{"x":0.32332,"y":0.84218,"w":0.59303,"h":0.01978,"fs":0.01279,"n":1,"t":"图形将类似于图4.51中的图形。如果我们从x0 = r - h开始，我们得到"},{"x":0.04848,"y":0.85414,"w":0.24767,"h":0.08919,"fs":0.01151,"n":3,"t":"图4.50 任何大于x = 1> 23的起始值x0都会导致例2中的根。"},{"x":0.32332,"y":0.85753,"w":0.59302,"h":0.03025,"fs":0.01279,"n":2,"t":"x1 = r + h，并且连续的近似值在这两个值之间来回移动。无论进行多少次迭代，都无法比我们的第一次猜测更接近根。"},{"x":0.05109,"y":0.86548,"w":0.21226,"h":0.01326,"fs":0.01023,"n":3,"t":"−1 2.12 3"},{"x":0.183,"y":0.86732,"w":0.01636,"h":0.01142,"fs":0.01023,"n":1,"t":"1.6"},{"x":0.32332,"y":0.88885,"w":0.59303,"h":0.04497,"fs":0.01279,"n":3,"t":"如果牛顿法收敛，它将收敛到一个根。但是要小心，有些情况下，方法看起来似乎收敛，但并没有根。幸运的是，这种情况很少见。"}]}