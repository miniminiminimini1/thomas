0.57582,"y":0.40448,"w":0.24196,"h":0.0217,"fs":0.01279,"n":1,"t":"2 = (-2)(-2) - (1)2 = 4 - 1 = 3."},{"x":0.51449,"y":0.40896,"w":0.06118,"h":0.01978,"fs":0.01279,"n":1,"t":"二阶偏导数 ƒyy - 二阶混合偏导数 ƒxy"},{"x":0.49632,"y":0.40959,"w":0.01802,"h":0.01593,"fs":0.01279,"n":1,"t":"二阶偏导数 ƒxx"},{"x":0.36258,"y":0.43261,"w":0.11132,"h":0.01427,"fs":0.01279,"n":1,"t":"组合"},{"x":0.22695,"y":0.43599,"w":0.0229,"h":0.01142,"fs":0.01023,"n":1,"t":"f inc"},{"x":0.68476,"y":0.45052,"w":0.1026,"h":0.02426,"fs":0.01279,"n":1,"t":"ƒyy - ƒxy 2 7 0"},{"x":0.20801,"y":0.4537,"w":0.01526,"h":0.01142,"fs":0.01023,"n":1,"t":"(b)"},{"x":0.52675,"y":0.455,"w":0.15786,"h":0.01978,"fs":0.02542,"n":1,"t":"ƒxx 6 0 and ƒxx"},{"x":0.08803,"y":0.4744,"w":0.25693,"h":0.07513,"fs":0.01151,"n":5,"t":"图14.47 (a) 原点是函数 ƒ(x, y) = y2 - x2 的鞍点。该函数没有局部极值（例2）。(b) 例2中函数 ƒ 的等高线。"},{"x":0.36258,"y":0.47802,"w":0.59296,"h":0.03257,"fs":0.01279,"n":2,"t":"这表明 ƒ 在点 (-2, -2) 处有一个局部极大值。该点处 ƒ 的值为 ƒ(-2, -2) = 8。"},{"x":0.36258,"y":0.52342,"w":0.56603,"h":0.0217,"fs":0.01407,"n":1,"t":"例4 求函数 ƒ(x, y) = 3y2 - 2y3 - 3x2 + 6xy 的局部极值。"},{"x":0.36258,"y":0.55821,"w":0.58618,"h":0.01542,"fs":0.01279,"n":1,"t":"解 由于 ƒ 在各处都可微，它只能在极值点处取极值。"},{"x":0.46307,"y":0.57714,"w":0.38797,"h":0.02426,"fs":0.02542,"n":1,"t":"函数 ƒ(x) = 6y - 6x = 0 和 ƒ(y) = 6y - 6y² + 6x = 0。"},{"x":0.36258,"y":0.60463,"w":0.59303,"h":0.03025,"fs":0.01279,"n":2,"t":"从这些方程中的第一个方程我们得到 x = y，然后将 y 代入第二个方程得到"},{"x":0.49796,"y":0.63852,"w":0.31821,"h":0.0217,"fs":0.02542,"n":1,"t":"6x - 6x² + 6x = 0 或 6x (2 - x) = 0。"},{"x":0.36258,"y":0.66665,"w":0.34555,"h":0.01427,"fs":0.01279,"n":1,"t":"因此，两个临界点是 (0, 0) 和 (2, 2)。"},{"x":0.39203,"y":0.68199,"w":0.43065,"h":0.01427,"fs":0.01279,"n":1,"t":"为了分类临界点，我们计算二阶导数："},{"x":0.51329,"y":0.70439,"w":0.28752,"h":0.01978,"fs":0.02542,"n":1,"t":"ƒxx = -6，ƒyy = 6 - 12y，ƒxy = 6。"},{"x":0.20377,"y":0.72143,"w":0.01309,"h":0.01142,"fs":0.01023,"n":1,"t":"10"},{"x":0.36258,"y":0.72803,"w":0.18656,"h":0.01427,"fs":0.01279,"n":1,"t":"判别式由"},{"x":0.56972,"y":0.74595,"w":0.2532,"h":0.0217,"fs":0.01279,"n":1,"t":"2 = (-36 + 72y) - 36 = 72(y - 1)."},{"x":0.49118,"y":0.75043,"w":0.07839,"h":0.01978,"fs":0.01279,"n":1,"t":"fxxfyy - fxy"},{"x":0.36258,"y":0.77407,"w":0.59308,"h":0.09101,"fs":0.01279,"n":6,"t":"在临界点(0, 0)处，我们看到判别式的值为负数-72，因此函数在原点处有一个鞍点。在临界点(2, 2)处，我们看到判别式具有正值72。将这个结果与第二偏导数fxx = -6的负值结合起来，定理11表明临界点(2, 2)给出了局部最大值f(2, 2) = 12 - 16 - 12 + 24 = 8。该曲面的图形如图14.48所示。"},{"x":0.18038,"y":0.81039,"w":0.01791,"h":0.0245,"fs":0.01023,"n":2,"t":"2 1"},{"x":0.08777,"y":0.87434,"w":0.18481,"h":0.01388,"fs":0.01151,"n":1,"t":"图14.48 曲面"},{"x":0.08777,"y":0.88601,"w":0.25396,"h":0.04812,"fs":0.01151,"n":3,"t":"z = 3y^2 - 2y^3 - 3x^2 + 6xy在原点处有一个鞍点，在点(2, 2)处有一个局部最大值（例4）。"},{"x":0.36258,"y":0.887,"w":0.59307,"h":0.04714,"fs":0.01407,"n":3,"t":"例5 求函数f(x, y) = 10xye-(x^2+y^2)的临界点，并使用二阶导数检验来分类每个点，确定它是一个鞍点、局部极小值点还是局部最大值点。"}]}