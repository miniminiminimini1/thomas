,"n":1,"t":"y(x)u(x + h) - u(x)"},{"x":0.62962,"y":0.33508,"w":0.22217,"h":0.03007,"fs":0.01279,"n":2,"t":"h - u(x)y(x + h) - y(x)"},{"x":0.50349,"y":0.3623,"w":0.04011,"h":0.01347,"fs":0.01279,"n":1,"t":"= lim"},{"x":0.65788,"y":0.36299,"w":0.20258,"h":0.02174,"fs":0.01279,"n":2,"t":"y(x + h)y(x) ."},{"x":0.52049,"y":0.37273,"w":0.02453,"h":0.01039,"fs":0.00895,"n":1,"t":"h→0"},{"x":0.36257,"y":0.39368,"w":0.59303,"h":0.02814,"fs":0.01279,"n":2,"t":"现在取分子和分母的极限，得到商法则。练习74概述了另一种证明方法。"},{"x":0.36258,"y":0.43844,"w":0.58901,"h":0.02814,"fs":0.01279,"n":2,"t":"在解决求导问题时选择使用哪种法则可能会影响你需要做的工作量。这里有一个例子。"},{"x":0.36258,"y":0.48278,"w":0.26156,"h":0.01449,"fs":0.01407,"n":1,"t":"例9 求下列函数的导数"},{"x":0.58135,"y":0.4998,"w":0.14612,"h":0.02727,"fs":0.01279,"n":1,"t":"y = (x - 1)(x^2 - 2x)"},{"x":0.66365,"y":0.51428,"w":0.06962,"h":0.02167,"fs":0.01279,"n":2,"t":"x^4 ."},{"x":0.36258,"y":0.54028,"w":0.59305,"h":0.04434,"fs":0.01279,"n":4,"t":"解使用商法则会导致一个复杂的表达式，包含许多项。相反，使用一些代数来简化表达式。首先展开分子并除以 x^4："},{"x":0.44492,"y":0.58715,"w":0.14612,"h":0.02727,"fs":0.01279,"n":1,"t":"y = (x - 1)(x^2 - 2x)"},{"x":0.52722,"y":0.58927,"w":0.18701,"h":0.03403,"fs":0.01279,"n":2,"t":"x^4 = x^3 - 3x^2 + 2x"},{"x":0.65828,"y":0.59647,"w":0.21143,"h":0.02683,"fs":0.01279,"n":2,"t":"x^4 = x^-1 - 3x^-2 + 2x^-3."},{"x":0.36259,"y":0.63233,"w":0.23678,"h":0.01279,"fs":0.01279,"n":1,"t":"然后使用和幂法则："},{"x":0.55161,"y":0.65245,"w":0.23711,"h":0.02973,"fs":0.01279,"n":2,"t":"dy/dx = -x^-2 - 3(-2)x^-3 + 2(-3)x^-4"},{"x":0.60488,"y":0.68818,"w":0.04839,"h":0.02887,"fs":0.01279,"n":1,"t":"x^2 + 6"},{"x":0.64259,"y":0.68818,"w":0.04839,"h":0.02879,"fs":0.01279,"n":1,"t":"x^3 - 6"},{"x":0.57445,"y":0.68834,"w":0.04112,"h":0.01982,"fs":0.01279,"n":1,"t":"= - 1"},{"x":0.68029,"y":0.69538,"w":0.01899,"h":0.02167,"fs":0.01279,"n":1,"t":"x^4."},{"x":0.36258,"y":0.7321,"w":0.28802,"h":0.01375,"fs":0.01375,"n":1,"t":"二阶及更高阶导数"},{"x":0.36258,"y":0.75608,"w":0.59301,"h":0.05951,"fs":0.01279,"n":4,"t":"如果 y = f(x) 是一个可导函数，那么它的导数 f′(x) 也是一个函数。如果 f′ 也是可导的，那么我们可以对 f′ 求导得到一个新的函数，用 f″ 表示。所以 f″ = (f′)′。函数 f″ 被称为 f 的二阶导数，因为它是一阶导数的导数。它可以用几种方式表示："},{"x":0.45802,"y":0.82153,"w":0.0787,"h":0.02386,"fs":0.01279,"n":1,"t":"f″(x) = d^2y"},{"x":0.5612,"y":0.82216,"w":0.04359,"h":0.0305,"fs":0.01279,"n":1,"t":"dx^2 ady"},{"x":0.58937,"y":0.82216,"w":0.07127,"h":0.0305,"fs":0.01279,"n":1,"t":"d^2x = dy′"},{"x":0.51517,"y":0.82538,"w":0.05783,"h":0.02889,"fs":0.01279,"n":1,"t":"dx^2 = d"},{"x":0.64252,"y":0.83118,"w":0.17629,"h":0.02148,"fs":0.01279,"n":1,"t":"dx = y″ = D^2(f)(x) = Dx"},{"x":0.81806,"y":0.83118,"w":0.03801,"h":0.01421,"fs":0.01279,"n":1,"t":"2f(x)."},{"x":0.36258,"y":0.86187,"w":0.48282,"h":0.01421,"fs":0.01279,"n":1,"t":"符号 D^2 表示求导操作进行了两次。"},{"x":0.39203,"y":0.87722,"w":0.24815,"h":0.01421,"fs":0.01279,"n":1,"t":"如果 y = x^6，那么 y′ = 6x^5，我们有"},{"x":0.56079,"y":0.8981,"w":0.05877,"h":0.02311,"fs":0.01279,"n":1,"t":"y″ = dy′"},{"x":0.60144,"y":0.90122,"w":0.05443,"h":0.02728,"fs":0.01279,"n":1,"t":"dx = d"},{"x":0.64407,"y":0.90702,"w":0.10975,"h":0.0215,"fs":0.01279,"n":1,"t":"dx (6x^5) = 30x^4."},{"x":0.36258,"y":0.93771,"w":0.14145,"h":0.01421,"fs":0.01401,"n":1,"t":"因此 D^2(x^6) = 30x^4."}]}