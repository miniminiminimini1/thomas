6,"h":0.02399,"fs":0.01023,"n":3,"t":"x t = ±√3 t = 0"},{"x":0.22126,"y":0.41671,"w":0.06544,"h":0.01023,"fs":0.01023,"n":2,"t":"2 4"},{"x":0.5,"y":0.42624,"w":0.29527,"h":0.01153,"fs":0.01151,"n":2,"t":"41. 心形线 42. 双曲线"},{"x":0.25725,"y":0.49971,"w":0.0309,"h":0.01078,"fs":0.01023,"n":1,"t":"t < 0"},{"x":0.14394,"y":0.5018,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"−1"},{"x":0.04849,"y":0.53062,"w":0.41586,"h":0.04015,"fs":0.01151,"n":3,"t":"表面积 求第21和22题中曲线绕指定轴旋转生成的曲面的面积。"},{"x":0.5,"y":0.55285,"w":0.27893,"h":0.01153,"fs":0.01151,"n":2,"t":"43. 圆 44. 心形线"},{"x":0.04849,"y":0.56778,"w":0.29181,"h":0.02091,"fs":0.01151,"n":4,"t":"21. x = t^2/2, y = 2t, 1/2 ≤ t ≤ 2; x轴"},{"x":0.04849,"y":0.58568,"w":0.36574,"h":0.02091,"fs":0.01151,"n":4,"t":"22. x = (t^2 + 1)/(2t), y = 4t, 1/2 ≤ t ≤ 1; y轴"},{"x":0.04849,"y":0.62142,"w":0.4159,"h":0.04015,"fs":0.01151,"n":3,"t":"极坐标到直角坐标方程 绘制第23至28题中的直线。同时，为每条直线找到直角坐标方程。"},{"x":0.04849,"y":0.66625,"w":0.37131,"h":0.02762,"fs":0.01151,"n":5,"t":"23. r cos au + p/3 b = 2√3 24. r cos au - 3p/4 b = 2√2"},{"x":0.5,"y":0.67051,"w":0.29527,"h":0.01153,"fs":0.01151,"n":2,"t":"45. 抛物线 46. 双曲线"},{"x":0.04848,"y":0.70701,"w":0.32195,"h":0.01212,"fs":0.01151,"n":2,"t":"25. r = 2 sec u 26. r = -2√2 sec u"},{"x":0.04849,"y":0.71127,"w":0.33356,"h":0.02576,"fs":0.01297,"n":2,"t":"27. r = -(3/2) csc u 28. r = 1/√3 csc u"},{"x":0.04849,"y":0.75495,"w":0.4159,"h":0.03964,"fs":0.01151,"n":3,"t":"为第29至32题中的圆找到直角坐标方程。在坐标平面上绘制每个圆，并用其直角坐标方程和极坐标方程标记。"},{"x":0.5,"y":0.79663,"w":0.41599,"h":0.04015,"fs":0.01151,"n":3,"t":"极坐标下的面积 求第47至50题中极坐标平面描述的区域的面积。"},{"x":0.05013,"y":0.80037,"w":0.31589,"h":0.01213,"fs":0.01151,"n":2,"t":"29. r = -4 sin u 30. r = 3√3 sin u"},{"x":0.04849,"y":0.81827,"w":0.30738,"h":0.01213,"fs":0.01151,"n":2,"t":"31. r = 2√2 cos u 32. r = -6 cos u"},{"x":0.5,"y":0.84257,"w":0.26312,"h":0.01213,"fs":0.01151,"n":1,"t":"47. 由心形线 r = 2 - cos u 围成的区域"},{"x":0.04849,"y":0.84395,"w":0.41599,"h":0.05422,"fs":0.01151,"n":4,"t":"直角坐标到极坐标方程 为第