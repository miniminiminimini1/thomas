28,"y":0.43118,"w":0.41766,"h":0.03393,"fs":0.01353,"n":3,"t":"a = (cos t - t sin t)i + (sin t + t cos t)j 0 a0^2 = t^2 + 1 经过一些代数运算"},{"x":0.20949,"y":0.43425,"w":0.04092,"h":0.02404,"fs":0.01023,"n":2,"t":"T a"},{"x":0.47464,"y":0.46225,"w":0.12231,"h":0.02776,"fs":0.01353,"n":1,"t":"aN = 20a0^2 - aT"},{"x":0.22003,"y":0.4706,"w":0.08151,"h":0.01585,"fs":0.01023,"n":2,"t":"P(x, y) tN"},{"x":0.15652,"y":0.49191,"w":0.0345,"h":0.02016,"fs":0.01023,"n":1,"t":"弦"},{"x":0.49836,"y":0.49321,"w":0.21662,"h":0.01795,"fs":0.01279,"n":1,"t":"= 2(t^2 + 1) - (1) = 2t^2 = t."},{"x":0.10466,"y":0.51713,"w":0.12281,"h":0.01146,"fs":0.01023,"n":2,"t":"Q r"},{"x":0.32332,"y":0.52136,"w":0.22963,"h":0.01281,"fs":0.01279,"n":1,"t":"然后我们使用方程(1)来找到a："},{"x":0.46952,"y":0.54372,"w":0.29654,"h":0.01499,"fs":0.01279,"n":1,"t":"a = aTT + aNN = (1)T + (t)N = T + tN."},{"x":0.32332,"y":0.57346,"w":0.05439,"h":0.01375,"fs":0.01375,"n":1,"t":"扭率"},{"x":0.23461,"y":0.58036,"w":0.06597,"h":0.0173,"fs":0.01023,"n":2,"t":"(1, 0) x"},{"x":0.32332,"y":0.58768,"w":0.59297,"h":0.03858,"fs":0.01279,"n":2,"t":"dB/ds在T、N和B之间的关系如何？从第13.1节中关于求叉积的导数的规则，我们有"},{"x":0.21392,"y":0.6204,"w":0.06811,"h":0.01461,"fs":0.01023,"n":1,"t":"x^2 + y^2 = 1"},{"x":0.48161,"y":0.63415,"w":0.10792,"h":0.03007,"fs":0.01279,"n":1,"t":"ds = d(T * N)"},{"x":0.61679,"y":0.63686,"w":0.13416,"h":0.02736,"fs":0.01279,"n":1,"t":"ds * N + T * dN"},{"x":0.47888,"y":0.63694,"w":0.02004,"h":0.01279,"fs":0.01279,"n":1,"t":"dB"},{"x":0.5492,"y":0.63694,"w":0.08489,"h":0.02728,"fs":0.01279,"n":2,"t":"ds = dT"},{"x":0.73322,"y":0.64416,"w":0.02356,"h":0.02008,"fs":0.01279,"n":1,"t":"ds ."},{"x":0.32333,"y":0.66441,"w":0.38092,"h":0.02323,"fs":0.01279,"n":1,"t":"由于N是dT/ds的方向，(dT/ds) * N = 0，因此"},{"x":0.04849,"y":0.67618,"w":0.23733,"h":0.04298,"fs":0.01151,"n":4,"t":"图13.27 对于t ≥ 0的运动r(t) = (cos t + t sin t)i +"},{"x":0.51067,"y":0.69824,"w":0.1305,"h":0.02736,"fs":0.01279,"n":1,"t":"ds = 0 + T * dN"},{"x":0.62344,"y":0.69824,"w":0.09845,"h":0.02736,"fs":0.01279,"n":1,"t":"ds = T * dN"},{"x":0.50794,"y":0.69833,"w":0.02003,"h":0.0128,"fs":0.01279,"n":1,"t":"dB"},{"x":0.70416,"y":0.70555,"w":0.02356,"h":0.02008,"fs":0.01279,"n":1,"t":"ds ."},{"x":0.04849,"y":0.72238,"w":0.24125,"h":0.0735,"fs":0.01151,"n":5,"t":"ds = 0 + T * dN"},{"x":0.32332,"y":0.7258,"w":0.59299,"h":0.03858,"fs":0.01279,"n":2,"t":"dB"},{"x":0.32332,"y":0.75649,"w":0.59308,"h":0.05392,"fs":0.01279,"n":3,"t":"对于t ≥ 0的运动r(t) = (sin t - t cos t)j，如果将一根绕固定圆缠绕的线在圆的平面内保持紧绷，其末端P将沿着圆的旋轮线运动（例1）。"},{"x":0.57846,"y":0.81599,"w":0.01907,"h":0.0128,"fs":0.01279,"n":1,"t":"从这一点我们可以看出dB/ds与T正交，因为叉积与其因子正交。"},{"x":0.58071,"y":0.82252,"w":0.0765,"h":0.02074,"fs":0.01279,"n":1,"t":"由于dB/ds也与B（后者长度恒定）正交，因此可以得出dB/ds与B和T的平面正交。换句话说，dB/ds与N平行，因此dB/ds是N的标量倍。用符号表示，"},{"x":0.32333,"y":0.84554,"w":0.59299,"h":0.02882,"fs":0.01279,"n":2,"t":"dB/ds = -tN."},{"x":0.50476,"y":0.88327,"w":0.2284,"h":0.02967,"fs":0.01918,"n":1,"t":"这个方程中的负号是传统的。标量t称为曲线上的扭率。注意，"},{"x":0.50251,"y":0.88505,"w":0.01907,"h":0.0128,"fs":0.01279,"n":1,"t":"dB"},{"x":0.32334,"y":0.92296,"w":0.288,"h":0.01279,"fs":0.01279,"n":1,"t":"我们使用这个方程来定义我们的下一个概念。"}]}