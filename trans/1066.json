.72195,"w":0.35961,"h":0.02238,"fs":0.01918,"n":1,"t":"(k + 1)! = (k + 1)(k!) ≥ 7(k + 1)3k ≥ 7^3k + 7 ≥ 7^3k + 1 ≥ 7^(k + 1)。"},{"x":0.32332,"y":0.75329,"w":0.10998,"h":0.01347,"fs":0.01279,"n":1,"t":"因此，对于k ≥ 7，"},{"x":0.49497,"y":0.7751,"w":0.24563,"h":0.01467,"fs":0.01279,"n":3,"t":"k! ≥ 7^3k 蕴含 (k + 1)! ≥ 7^(k + 1)。"},{"x":0.32332,"y":0.79858,"w":0.50492,"h":0.01422,"fs":0.01279,"n":1,"t":"数学归纳原理现在保证了对于所有n ≥ 7，有n! ≥ 7^n。"},{"x":0.32332,"y":0.83674,"w":0.45954,"h":0.02909,"fs":0.01375,"n":2,"t":"有限多个函数和的导数和法则的证明"},{"x":0.32332,"y":0.87674,"w":0.15312,"h":0.01279,"fs":0.01279,"n":1,"t":"我们证明该命题"},{"x":0.68197,"y":0.90542,"w":0.11587,"h":0.02975,"fs":0.01279,"n":1,"t":"dx + g + du_n"},{"x":0.43775,"y":0.9055,"w":0.21663,"h":0.02968,"fs":0.01279,"n":2,"t":"d/dx (u_1 + u_2 + g + u_n) = du_1"},{"x":0.6359,"y":0.9055,"w":0.06456,"h":0.02967,"fs":0.01279,"n":1,"t":"dx + du_2"},{"x":0.7793,"y":0.92238,"w":0.01543,"h":0.01279,"fs":0.01279,"n":1,"t":"dx"}]}