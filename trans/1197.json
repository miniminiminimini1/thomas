.01982,"fs":0.01279,"n":1,"t":"cos A cos B = 1"},{"x":0.66573,"y":0.21361,"w":0.20713,"h":0.02703,"fs":0.01279,"n":2,"t":"2 cos(A - B) + 1 / 2 cos(A + B)"},{"x":0.04849,"y":0.22664,"w":0.06557,"h":0.01247,"fs":0.01247,"n":1,"t":"恒等式"},{"x":0.5656,"y":0.24558,"w":0.10559,"h":0.01982,"fs":0.01279,"n":1,"t":"sin A cos B = 1"},{"x":0.66301,"y":0.24558,"w":0.20168,"h":0.02703,"fs":0.01279,"n":2,"t":"2 sin(A - B) + 1 / 2 sin(A + B)"},{"x":0.07875,"y":0.24574,"w":0.43874,"h":0.05184,"fs":0.01279,"n":7,"t":"sin(-u) = -sin u, cos (-u) = cos u, sin^2 u + cos^2 u = 1, sec^2 u = 1 + tan^2 u, csc^2 u = 1 + cot^2 u, sin 2u = 2 sin u cos u, cos 2u = cos^2 u - sin^2 u"},{"x":0.5656,"y":0.27755,"w":0.15853,"h":0.01982,"fs":0.01279,"n":1,"t":"sin A + sin B = 2 sin (1 / 2) (A + B)"},{"x":0.71595,"y":0.27755,"w":0.16496,"h":0.02703,"fs":0.01279,"n":2,"t":"2 (A + B) cos (1 / 2) (A - B)"},{"x":0.07875,"y":0.30113,"w":0.13777,"h":0.02075,"fs":0.01279,"n":1,"t":"cos^2 u = 1 + cos 2u"},{"x":0.17524,"y":0.30113,"w":0.19695,"h":0.02796,"fs":0.01279,"n":3,"t":"2 / √2, sin^2 u = 1 - cos 2u"},{"x":0.56559,"y":0.30953,"w":0.16126,"h":0.01982,"fs":0.01279,"n":1,"t":"sin A - sin B = 2 cos (1 / 2) (A - B)"},{"x":0.71867,"y":0.30953,"w":0.16224,"h":0.02703,"fs":0.01279,"n":2,"t":"2 (A + B) sin (1 / 2) (A - B)"},{"x":0.08284,"y":0.31629,"w":0.27372,"h":0.08615,"fs":0.01279,"n":5,"t":"2 sin(A + B) = sin A cos B + cos A sin B, sin(A - B) = sin A cos B - cos A sin B, cos(A + B) = cos A cos B - sin A sin B, cos(A - B) = cos A cos B + sin A sin B"},{"x":0.56559,"y":0.3415,"w":0.16671,"h":0.01982,"fs":0.01279,"n":1,"t":"cos A + cos B = 2 cos (1 / 2) (A + B)"},{"x":0.72412,"y":0.3415,"w":0.16496,"h":0.02703,"fs":0.01279,"n":2,"t":"2 (A + B) cos (1 / 2) (A - B)"},{"x":0.56559,"y":0.37347,"w":0.17525,"h":0.01982,"fs":0.01279,"n":1,"t":"cos A - cos B = -2 sin (1 / 2) (A - B)"},{"x":0.73266,"y":0.37347,"w":0.16224,"h":0.02703,"fs":0.01279,"n":2,"t":"2 (A + B) sin (1 / 2) (A - B)"},{"x":0.04849,"y":0.43847,"w":0.