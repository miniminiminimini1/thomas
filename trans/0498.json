5,"fs":0.01279,"n":2,"t":"解 如果我们将方程(3)的两边乘以(x - 1)以得到"},{"x":0.46464,"y":0.82108,"w":0.22067,"h":0.03235,"fs":0.01279,"n":2,"t":"x^2 + 1 (x - 2)(x - 3) = A + B(x - 1)"},{"x":0.63515,"y":0.82343,"w":0.13621,"h":0.03,"fs":0.01279,"n":2,"t":"x - 2 + C(x - 1)"},{"x":0.72072,"y":0.83988,"w":0.03976,"h":0.01347,"fs":0.01279,"n":1,"t":"x - 3"},{"x":0.32333,"y":0.86345,"w":0.37923,"h":0.01347,"fs":0.01279,"n":1,"t":"并将 x = 1 代入，得到的方程给出了 A 的值："},{"x":0.5149,"y":0.88162,"w":0.20667,"h":0.03448,"fs":0.01279,"n":2,"t":"(1)^2 + 1 (1 - 2)(1 - 3) = A + 0 + 0,"},{"x":0.60819,"y":0.92228,"w":0.04656,"h":0.01347,"fs":0.01279,"n":1,"t":"A = 1."}]}