5,"h":0.01078,"fs":0.01023,"n":1,"t":"-4"},{"x":0.32332,"y":0.36661,"w":0.32083,"h":0.01279,"fs":0.01279,"n":1,"t":"该函数的图像如图9.1所示。"},{"x":0.04849,"y":0.36715,"w":0.23841,"h":0.02762,"fs":0.01151,"n":3,"t":"图9.1 例2初值问题的解的图形"},{"x":0.32332,"y":0.40334,"w":0.28871,"h":0.01375,"fs":0.01375,"n":1,"t":"斜率场：观察解曲线"},{"x":0.32331,"y":0.42731,"w":0.59312,"h":0.15159,"fs":0.01279,"n":10,"t":"每次我们为微分方程 y′ = ƒ(x, y) 的解指定一个初始条件 y(x0) = y0，解曲线（解的图形）必须通过点 (x0, y0) 并在该点具有斜率 ƒ(x0, y0)。我们可以通过在 xy-平面构成 ƒ 的定义域的选定点 (x, y) 处绘制斜率为 ƒ(x, y) 的短线段来形象地表示这些斜率。每个线段具有与通过 (x, y) 的解曲线相同的斜率，因此在该点与曲线相切。得到的图形称为斜率场（或方向场），它给出了解曲线的一般形状的直观表示。图9.2a显示了斜率场，图9.2b中在其中画出了特定的解。我们看到这些线段如何指示解曲线在通过每个点时的方向。"},{"x":0.50032,"y":0.60562,"w":0.27162,"h":0.02144,"fs":0.01023,"n":6,"t":"y y 0, 2 3 a b"},{"x":0.60846,"y":0.69679,"w":0.22844,"h":0.01023,"fs":0.01023,"n":2,"t":"x x"},{"x":0.40161,"y":0.70291,"w":0.19166,"h":0.01078,"fs":0.01023,"n":5,"t":"0 2 −2 −4 4"},{"x":0.62423,"y":0.70291,"w":0.19167,"h":0.01078,"fs":0.01023,"n":5,"t":"0 2 −2 −4 4"},{"x":0.48352,"y":0.73052,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"−2"},{"x":0.70616,"y":0.73052,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"-2"},{"x":0.48352,"y":0.76433,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"-4"},{"x":0.70616,"y":0.76434,"w":0.01745,"h":0.01078,"fs":0.01023,"n":1,"t":"-4"},{"x":0.49626,"y":0.7864,"w":0.23785,"h":0.01023,"fs":0.01023,"n":2,"t":"(a) (b)"},{"x":0.4016,"y":0.80825,"w":0.21757,"h":0.02048,"fs":0.01151,"n":2,"t":"图9.2 (a) dy/dx = y - x 的斜率场。 (b) 通过点 a0, 2/3b 的特解曲线（例2）。"},{"x":0.60531,"y":0.81661,"w":0.21588,"h":0.0189,"fs":0.01151,"n":1,"t":"7"},{"x":0.40159,"y":0.83852,"w":0.20044,"h":0.02091,"fs":0.01151,"n":1,"t":""},{"x":0.59467,"y":0.83852,"w":0.0982,"h":0.02761,"fs":0.01151,"n":1,"t":"3b"},{"x":0.32332,"y":0.89212,"w":0.5929,"h":0.04348,"fs":0.01279,"n":3,"t":"图9.3展示了三个斜率场，我们可以通过跟随这些场中的切线段来观察解曲线的行为。斜率场是有用的，因为它们显示了给定微分方程的解曲线族的整体行为。"}]}