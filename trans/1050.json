7563,"w":0.02606,"h":0.01999,"fs":0.01279,"n":1,"t":"0x - 0M 0y b dx dy = O R"},{"x":0.55919,"y":0.47563,"w":0.15841,"h":0.04079,"fs":0.01279,"n":4,"t":"F # T ds ="},{"x":0.44252,"y":0.47708,"w":0.06739,"h":0.02238,"fs":0.01918,"n":1,"t":"∇* F # k dA."},{"x":0.72296,"y":0.47708,"w":0.09231,"h":0.02238,"fs":0.01918,"n":1,"t":"F C"},{"x":0.42105,"y":0.4969,"w":0.01768,"h":0.01952,"fs":0.01279,"n":2,"t":"O R"},{"x":0.5197,"y":0.4969,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"t":"现在有了格林定理的del符号方程，我们可以看到它们与斯托克斯定理和散度定理中的方程之间的关系，所有这些都总结在这里。"},{"x":0.32333,"y":0.52316,"w":0.59292,"h":0.02814,"fs":0.01279,"n":2,"t":"格林定理及其三维推广"},{"x":0.3536,"y":0.58263,"w":0.42966,"h":0.01279,"fs":0.01279,"n":1,"t":"F # T ds ="},{"x":0.67139,"y":0.60435,"w":0.06739,"h":0.02238,"fs":0.01918,"n":1,"t":"∇* F # k dA"},{"x":0.77645,"y":0.60435,"w":0.08827,"h":0.02238,"fs":0.01918,"n":1,"t":"Tangential form of Green’s Theorem:"},{"x":0.3536,"y":0.61333,"w":0.26083,"h":0.01279,"fs":0.01279,"n":1,"t":"F C"},{"x":0.64977,"y":0.62418,"w":0.01786,"h":0.01952,"fs":0.01279,"n":2,"t":"O R"},{"x":0.74858,"y":0.62418,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"t":"F # T ds ="},{"x":0.67139,"y":0.65167,"w":0.06739,"h":0.02238,"fs":0.01918,"n":1,"t":"∇* F # n ds"},{"x":0.77645,"y":0.65167,"w":0.08924,"h":0.02238,"fs":0.01918,"n":1,"t":"Stokes’ Theorem:"},{"x":0.3536,"y":0.66064,"w":0.12309,"h":0.01279,"fs":0.01279,"n":1,"t":"F C"},{"x":0.65166,"y":0.6715,"w":0.01597,"h":0.01952,"fs":0.01279,"n":2,"t":"O S"},{"x":0.74858,"y":0.6715,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"t":"F # n ds ="},{"x":0.67317,"y":0.69899,"w":0.06561,"h":0.02238,"fs":0.01918,"n":1,"t":"∇# F dA"},{"x":0.77645,"y":0.69899,"w":0.0548,"h":0.02177,"fs":0.01918,"n":1,"t":"Normal form of Green’s Theorem:"},{"x":0.3536,"y":0.70796,"w":0.2405,"h":0.01279,"fs":0.01279,"n":1,"t":"F C"},{"x":0.6517,"y":0.71882,"w":0.01769,"h":0.01952,"fs":0.01279,"n":2,"t":"O R"},{"x":0.74858,"y":0.71882,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"t":"F # n ds ="},{"x":0.66856,"y":0.74631,"w":0.07022,"h":0.02238,"fs":0.01918,"n":1,"t":"∇# F dV"},{"x":0.77814,"y":0.74631,"w":0.0548,"h":0.02177,"fs":0.01918,"n":1,"t":"Divergence Theorem:"},{"x":0.35358,"y":0.75528,"w":0.15,"h":0.01279,"fs":0.01279,"n":1,"t":"O S"},{"x":0.6415,"y":0.76613,"w":0.02251,"h":0.01952,"fs":0.01279,"n":2,"t":"l D"},{"x":0.74613,"y":0.76613,"w":0.02905,"h":0.01952,"fs":0.01279,"n":2,"t":"注意斯托克斯定理如何将格林定理的切向（旋度）形式从平面上的平坦表面推广到三维空间中的表面。在每种情况下，对有向表面内部的旋度场积分等于F在边界上的环量。"},{"x":0.32332,"y":0.81526,"w":0.5931,"h":0.05883,"fs":0.01279,"n":4,"t":"同样，散度定理将格林定理的普通（通量）形式从平面上的二维区域推广到空间中的三维区域。在每种情况下，对区域内部的∇# F的积分等于该区域边界包围的场的总通量。"},{"x":0.32332,"y":0.87665,"w":0.59307,"h":0.05883,"fs":0.01918,"n":4,"t":"Likewise, the Divergence Theorem generalizes the normal (flux) form of Green’s Theorem from a two-dimensional region in the plane to a three-dimensional region in space. In each case, the integral of ∇# F over the interior of the region equals the total flux of the field across the boundary enclosing the region."}]}