0.01279,"n":2,"t":"如果 a 7 0 且 u 是 x 的可微函数，那么 au 是 x 的可微函数，并且"},{"x":0.55537,"y":0.59185,"w":0.11913,"h":0.02727,"fs":0.01279,"n":2,"t":"d/dx au = au ln a du/dx."},{"x":0.65862,"y":0.59906,"w":0.02167,"h":0.02006,"fs":0.01279,"n":1,"t":"dx."},{"x":0.32332,"y":0.66173,"w":0.27838,"h":0.01279,"fs":0.01279,"n":1,"t":"这个最后结果的积分等价形式是"},{"x":0.56749,"y":0.72308,"w":0.07802,"h":0.0214,"fs":0.01279,"n":1,"t":"au du = au"},{"x":0.62614,"y":0.73103,"w":0.06434,"h":0.02076,"fs":0.01279,"n":1,"t":"ln a + C."},{"x":0.32332,"y":0.79688,"w":0.17925,"h":0.01394,"fs":0.01375,"n":1,"t":"以 a 为底的对数"},{"x":0.32332,"y":0.82011,"w":0.59305,"h":0.02957,"fs":0.01279,"n":2,"t":"如果 a 是除了 1 以外的任何正数，函数 ax 是一一对应的，并且在每个点都有非零的导数。因此，它有一个可微的逆函数。"},{"x":0.35441,"y":0.89127,"w":0.5284,"h":0.03023,"fs":0.01279,"n":3,"t":"定义 对于任何正数 a ≠1，以 a 为底的对数 x，记作 log ax，是 ax 的逆函数。"}]}