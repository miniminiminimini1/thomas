":0.4574,"w":0.38013,"h":0.03969,"fs":0.01918,"n":3,"t":"= (1 + 2 + 3) + (3 # 4) 常数值规则 = 6 + 12 = 18"},{"x":0.41731,"y":0.50344,"w":0.05993,"h":0.02594,"fs":0.01918,"n":2,"t":"1 n = n # 1"},{"x":0.74688,"y":0.50583,"w":0.11269,"h":0.0243,"fs":0.01023,"n":2,"t":"常数值规则 (1>n 是常数)"},{"x":0.46906,"y":0.51175,"w":0.2662,"h":0.01764,"fs":0.01279,"n":1,"t":"n = 1"},{"x":0.36258,"y":0.51337,"w":0.05008,"h":0.01533,"fs":0.01279,"n":2,"t":"(d) a"},{"x":0.39399,"y":0.52654,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"t":"k=1"},{"x":0.36258,"y":0.54952,"w":0.59302,"h":0.05883,"fs":0.01279,"n":4,"t":"多年来，人们已经发现了许多有限和的公式。其中最著名的是前 n 个整数的和的公式（据说高斯在 8 岁时发现了它）以及前 n 个整数的平方和立方和的公式。"},{"x":0.0992,"y":0.56807,"w":0.1615,"h":0.01023,"fs":0.01023,"n":1,"t":"历史传记"},{"x":0.0992,"y":0.58354,"w":0.12145,"h":0.02365,"fs":0.01023,"n":2,"t":"卡尔·弗里德里希·高斯（1777–1855）"},{"x":0.36258,"y":0.62455,"w":0.40074,"h":0.01449,"fs":0.01407,"n":1,"t":"例4 证明前 n 个整数的和是"},{"x":0.62041,"y":0.64566,"w":0.0914,"h":0.02278,"fs":0.01279,"n":1,"t":"k = n(n + 1)"},{"x":0.67786,"y":0.65568,"w":0.03813,"h":0.01999,"fs":0.01279,"n":2,"t":"2 ."},{"x":0.59926,"y":0.66977,"w":0.02002,"h":0.00916,"fs":0.0087,"n":1,"t":"k=1"},{"x":0.36258,"y":0.68423,"w":0.44565,"h":0.01365,"fs":0.01279,"n":2,"t":"解 这个公式告诉我们前 4 个整数的和是"},{"x":0.61561,"y":0.70645,"w":0.03812,"h":0.01279,"fs":0.01279,"n":1,"t":"(4)(5)"},{"x":0.63058,"y":0.7151,"w":0.068,"h":0.02068,"fs":0.01279,"n":2,"t":"2 = 10."},{"x":0.36257,"y":0.74136,"w":0.21345,"h":0.01279,"fs":0.01279,"n":1,"t":"加法验证了这个预测："},{"x":0.5818,"y":0.76369,"w":0.1505,"h":0.01347,"fs":0.01279,"n":1,"t":"1 + 2 + 3 + 4 = 10."},{"x":0.36258,"y":0.78484,"w":0.59289,"h":0.02814,"fs":0.01279,"n":2,"t":"为了证明这个公式的一般性，我们将求和的项写出来两次，一次正向一次反向。"},{"x":0.46764,"y":0.82086,"w":0.37477,"h":0.03273,"fs":0.01279,"n":18,"t":"1 + 2 + 3 + g + n n + (n - 1) + (n - 2) + g + 1"},{"x":0.36258,"y":0.86089,"w":0.5931,"h":0.07486,"fs":0.01279,"n":5,"t":"如果我们把第一列的两个项相加，我们得到 1 + n = n + 1。同样，如果我们把第二列的两个项相加，我们得到 2 + (n - 1) = n + 1。任何一列的两个项之和都是 n + 1。当我们把 n 列相加时，我们得到 n 个项，每个项都是 n + 1，总和为 n(n + 1)。由于这是所需量的两倍，所以前 n 个整数的和是 (n)(n + 1)>2."}]}