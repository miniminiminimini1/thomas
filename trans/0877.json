柱 x2 + y2 = 1 得到一个椭圆（图 14.59）。找到椭圆上离原点最近和最远的点。"},{"x":0.36259,"y":0.50501,"w":0.27078,"h":0.01542,"fs":0.01279,"n":1,"t":"解 我们找到"},{"x":0.57321,"y":0.52138,"w":0.16769,"h":0.0217,"fs":0.01279,"n":1,"t":"ƒ(x, y, z) = x2 + y2 + z2"},{"x":0.36258,"y":0.54695,"w":0.51567,"h":0.01427,"fs":0.01279,"n":1,"t":"(点 (x, y, z) 到原点的距离的平方) 在约束条件"},{"x":0.54172,"y":0.56231,"w":0.4098,"h":0.0217,"fs":0.01279,"n":2,"t":"g1(x, y, z) = x2 + y2 - 1 = 0 (3)"},{"x":0.54172,"y":0.58597,"w":0.40979,"h":0.01723,"fs":0.01279,"n":2,"t":"g2(x, y, z) = x + y + z - 1 = 0 (4) 下"},{"x":0.36258,"y":0.60705,"w":0.32331,"h":0.01427,"fs":0.01279,"n":1,"t":"方程 (2) 中的梯度方程给出"},{"x":0.47792,"y":0.62646,"w":0.35673,"h":0.05603,"fs":0.01279,"n":3,"t":"∇ƒ = l∇g1 + m∇g2 2xi + 2yj + 2zk = l(2xi + 2yj) + m(i + j + k) 2xi + 2yj + 2zk = (2lx + m)i + (2ly + m)j + mk"},{"x":0.71272,"y":0.73977,"w":0.10868,"h":0.01318,"fs":0.01023,"n":1,"t":"圆柱 x2 + y2 = 1"},{"x":0.6214,"y":0.759,"w":0.0129,"h":0.01326,"fs":0.01023,"n":1,"t":"P2"},{"x":0.70771,"y":0.80063,"w":0.04143,"h":0.01142,"fs":0.01023,"n":1,"t":"(0, 1, 0)"},{"x":0.57205,"y":0.81615,"w":0.04143,"h":0.01142,"fs":0.01023,"n":1,"t":"(1, 0, 0)"},{"x":0.66962,"y":0.83338,"w":0.0129,"h":0.01326,"fs":0.01023,"n":1,"t":"P1"},{"x":0.56053,"y":0.83599,"w":0.23722,"h":0.02915,"fs":0.01023,"n":3,"t":"平面 x + y + z = 1 x"},{"x":0.4866,"y":0.90504,"w":0.32918,"h":0.04444,"fs":0.01151,"n":3,"t":"图 14.59 在平面和圆柱相交的椭圆上，我们找到离原点最近和最远的点（例 5）。"}]}