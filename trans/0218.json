w":0.31782,"h":0.01347,"fs":0.01279,"n":1,"t":"在 x = 3.2 处，例 2 中的线性化给出"},{"x":0.40927,"y":0.64603,"w":0.41866,"h":0.02719,"fs":0.01279,"n":4,"t":"21 + x = 21 + 3.2 ≈5 4 + 3.2 4 = 1.250 + 0.800 = 2.050，"},{"x":0.32332,"y":0.68324,"w":0.59306,"h":0.02882,"fs":0.01279,"n":2,"t":"这个值与真实值 24.2 ≈2.04939 的差不到千分之一。例 1 中的线性化给出"},{"x":0.43998,"y":0.72187,"w":0.35726,"h":0.02719,"fs":0.01279,"n":3,"t":"21 + x = 21 + 3.2 ≈1 + 3.2 2 = 1 + 1.6 = 2.6，"},{"x":0.32333,"y":0.75976,"w":0.24267,"h":0.01279,"fs":0.01279,"n":1,"t":"这个结果与真实值相差超过 25%。"},{"x":0.32332,"y":0.78001,"w":0.54555,"h":0.02323,"fs":0.01407,"n":1,"t":"例 3 求函数 ƒ(x) = cos x 在 x = p>2 处的线性化（见图 3.54）。"},{"x":0.32333,"y":0.80687,"w":0.58649,"h":0.03858,"fs":0.01279,"n":3,"t":"解 由于 ƒ(p>2) = cos(p>2) = 0，ƒ′(x) = -sin x，且 ƒ′(p>2) = -sin(p>2) = -1，我们找到在 a = p>2 处的线性化为"},{"x":0.05752,"y":0.81615,"w":0.06554,"h":0.01294,"fs":0.01023,"n":2,"t":"0 p"},{"x":0.11521,"y":0.82682,"w":0.14912,"h":0.01131,"fs":0.01023,"n":2,"t":"y = cos x"},{"x":0.0823,"y":0.84179,"w":0.06703,"h":0.01558,"fs":0.01023,"n":1,"t":"y = −x + p"},{"x":0.54008,"y":0.85499,"w":0.18646,"h":0.01347,"fs":0.01279,"n":1,"t":"L(x) = ƒ(a) + ƒ′(a)(x - a)"},{"x":0.57466,"y":0.87375,"w":0.13348,"h":0.02323,"fs":0.01279,"n":1,"t":"= 0 + (-1)ax - p"},{"x":0.6983,"y":0.87375,"w":0.01874,"h":0.03044,"fs":0.01279,"n":1,"t":"2 b"},{"x":0.04849,"y":0.87779,"w":0.25443,"h":0.02763,"fs":0.01151,"n":3,"t":"图3.54 ƒ(x) = cos x 的图像及其在 x = p>2 处的线性化。在 x = p>2 附近，cos x ≈-x + (p>2)（例3）。"},{"x":0.04849,"y":0.89986,"w":0.19185,"h":0.03625,"fs":0.01151,"n":2,"t":"x = p>2, cos x ≈-x + (p>2)（例3）。"},{"x":0.57466,"y":0.90867,"w":0.07137,"h":0.02065,"fs":0.01279,"n":1,"t":"1 = -x + p"},{"x":0.63621,"y":0.91655,"w":0.0156,"h":0.01999,"fs":0.01279,"n":1,"t":"2."}]}