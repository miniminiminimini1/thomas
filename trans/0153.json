 dy"},{"x":0.45233,"y":0.29006,"w":0.10789,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (u - y) = d"},{"x":0.75769,"y":0.29006,"w":0.05699,"h":0.02727,"fs":0.01279,"n":1,"t":"dx = du"},{"x":0.83992,"y":0.29727,"w":0.02193,"h":0.02006,"fs":0.01279,"n":1,"t":"dx"},{"x":0.36258,"y":0.32729,"w":0.58812,"h":0.03069,"fs":0.01279,"n":2,"t":"求和法则也适用于两个以上函数的有限和。如果 u1, u2, c, un 在 x 处可导，那么 u1 + u2 + g + un 也在 x 处可导，并且"},{"x":0.71774,"y":0.36342,"w":0.10276,"h":0.02975,"fs":0.01279,"n":1,"t":"dx + g+ dun"},{"x":0.48788,"y":0.3635,"w":0.20227,"h":0.02968,"fs":0.01279,"n":2,"t":"d/dx (u1 + u2 + g+ un) = du1/dx + du2/dx"},{"x":0.67167,"y":0.3635,"w":0.06456,"h":0.02967,"fs":0.01279,"n":1,"t":"dx + du2"},{"x":0.80202,"y":0.37311,"w":0.02428,"h":0.02008,"fs":0.01279,"n":1,"t":"dx"},{"x":0.36258,"y":0.40381,"w":0.45637,"h":0.01279,"fs":0.01279,"n":1,"t":"例如，为了证明该法则对三个函数成立，我们计算"},{"x":0.66945,"y":0.42392,"w":0.12968,"h":0.02977,"fs":0.01279,"n":1,"t":"d/dx (u1 + u2) + du3"},{"x":0.87278,"y":0.42392,"w":0.06456,"h":0.02975,"fs":0.01279,"n":1,"t":"dx + du3"},{"x":0.78064,"y":0.424,"w":0.06456,"h":0.02967,"fs":0.01279,"n":1,"t":"dx = du1"},{"x":0.82671,"y":0.424,"w":0.06456,"h":0.02967,"fs":0.01279,"n":1,"t":"dx + du2"},{"x":0.37104,"y":0.42639,"w":0.15556,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (u1 + u2 + u3) = d"},{"x":0.5148,"y":0.42639,"w":0.16645,"h":0.02729,"fs":0.01279,"n":1,"t":"d/dx ((u1 + u2) + u3) = d"},{"x":0.91886,"y":0.43361,"w":0.02428,"h":0.02008,"fs":0.01279,"n":1,"t":"d/dx ."},{"x":0.36259,"y":0.4643,"w":0.58674,"h":0.01279,"fs":0.01279,"n":1,"t":"附录2给出了任何有限个项的数学归纳法证明。"},{"x":0.36258,"y":0.49426,"w":0.44707,"h":0.01982,"fs":0.01407,"n":1,"t":"例3 求多项式 y = x3 + 4 的导数"},{"x":0.80147,"y":0.49614,"w":0.09989,"h":0.02507,"fs":0.01279,"n":1,"t":"3x^2 - 5x + 1."},{"x":0.53219,"y":0.53344,"w":0.03791,"h":0.0305,"fs":0.01279,"n":1,"t":"dx a4"},{"x":0.56193,"y":0.53344,"w":0.14057,"h":0.03052,"fs":0.01279,"n":2,"t":"3x^2b - d/dx (5x) + d"},{"x":0.36259,"y":0.53421,"w":0.12622,"h":0.02973,"fs":0.01279,"n":3,"t":"解 dy/dx = d"},{"x":0.47701,"y":0.53667,"w":0.06698,"h":0.02728,"fs":0.01279,"n":1,"t":"d/dx x^3 + d"},{"x":0.69068,"y":0.54388,"w":0.2103,"h":0.02008,"fs":0.01279,"n":2,"t":"d/dx (1) 和差公式"},{"x":0.52271,"y":0.57236,"w":0.21984,"h":0.0295,"fs":0.01918,"n":2,"t":"3 # 2x - 5 + 0 = 3x^2 + 8 3x - 5"},{"x":0.45994,"y":0.57432,"w":0.07096,"h":0.01982,"fs":0.01279,"n":1,"t":"= 3x^2 + 4"},{"x":0.36258,"y":0.61745,"w":0.58894,"h":0.02814,"fs":0.01279,"n":2,"t":"我们可以逐项对任何多项式进行求导，就像我们在例3中对多项式进行求导一样。所有多项式在所有x的值处都是可导的。"},{"x":0.36258,"y":0.66006,"w":0.59305,"h":0.03329,"fs":0.01407,"n":2,"t":"例4 曲线 y = x^4 - 2x^2 + 2 有水平切线吗？如果有，在哪里？"},{"x":0.36259,"y":0.69698,"w":0.58172,"h":0.02323,"fs":0.01279,"n":2,"t":"解 如果有水平切线，它们出现在斜率 dy/dx 为零的地方。我们有"},{"x":0.19645,"y":0.71868,"w":0.09561,"h":0.01461,"fs":0.01023,"n":1,"t":"y = x^4 −2x^2 + 2"},{"x":0.53144,"y":0.72755,"w":0.05171,"h":0.02973,"fs":0.01279,"n":2,"t":"dy/dx = d/dx (x^4 - 2x^2 + 2) = 4x^3 - 4x."},{"x":0.57135,"y":0.73206,"w":0.2114,"h":0.02524,"fs":0.01279,"n":1,"t":"现在解方程 dy/dx = 0 对 x："},{"x":0.3626,"y":0.76758,"w":0.17468,"h":0.02246,"fs":0.01279,"n":1,"t":""},{"x":0.52185,"y":0.77657,"w":0.08699,"h":0.02074,"fs":0.01279,"n":1,"t":""},{"x":0.17216,"y":0.77974,"w":0.02835,"h":0.01023,"fs":0.01023,"n":1,"t":"(0, 2)"},{"x":0.59592,"y":0.81046,"w":0.15253,"h":0.05632,"fs":0.01279,"n":3,"t":"4x^3 - 4x = 0 4x(x^2 - 1) = 0 x = 0, 1, -1."},{"x":0.10501,"y":0.82271,"w":0.12494,"h":0.0176,"fs":0.01023,"n":3,"t":"(1, 1) (-1, 1) 1"},{"x":0.11002,"y":0.86513,"w":0.10912,"h":0.01078,"fs":0.01023,"n":3,"t":"0 1 -1"},{"x":0.36258,"y":0.87185,"w":0.59307,"h":0.06399,"fs":0.01279,"n":4,"t":"曲线 y = x^4 - 2x^2 + 2 在 x = 0, 1 和 -1 处有水平切线。曲线上相应的点是 (0, 2), (1, 1) 和 (-1, 1)。见图 3.11。在第 4 章中，我们将看到找到函数导数等于零的 x 值是一个重要且有用的过程。"},{"x":0.08775,"y":0.8914,"w":0.2482,"h":0.02762,"fs":0.01151,"n":3,"t":"图 3.11 例子 4 中的曲线及其水平切线。"}]}