1279,"n":2,"t":"解 我们直接应用链式法则，得到"},{"x":0.50716,"y":0.44242,"w":0.29987,"h":0.05567,"fs":0.01918,"n":10,"t":"d dx sin (x^2 + ex) = cos (x^2 + ex) # (2x + ex). (1)1* (1)1* (1)1* 内层 内层 左边的内层导数"},{"x":0.36258,"y":0.52261,"w":0.27418,"h":0.01449,"fs":0.01407,"n":2,"t":"例题 4 求导 y = ecosx。"},{"x":0.36258,"y":0.55031,"w":0.593,"h":0.02899,"fs":0.01279,"n":3,"t":"解 在这里，内层函数是 u = g(x) = cos x，外层函数是指数函数 ƒ(x) = ex。应用链式法则，我们得到"},{"x":0.44201,"y":0.58664,"w":0.05171,"h":0.02973,"fs":0.01279,"n":2,"t":"dy dx = d"},{"x":0.48192,"y":0.5891,"w":0.13017,"h":0.0276,"fs":0.01401,"n":1,"t":"dx (ecos x) = ecos x d"},{"x":0.6003,"y":0.59488,"w":0.27186,"h":0.02151,"fs":0.01279,"n":1,"t":"dx (cos x) = ecos x(-sin x) = -ecos xsin x."},{"x":0.36258,"y":0.62701,"w":0.46005,"h":0.01279,"fs":0.01279,"n":1,"t":"推广例题 4，我们看到链式法则给出了以下公式"},{"x":0.61023,"y":0.68261,"w":0.08792,"h":0.02727,"fs":0.01279,"n":2,"t":"d dxeu = eu du"},{"x":0.68228,"y":0.68983,"w":0.02167,"h":0.02006,"fs":0.01279,"n":1,"t":"dx."},{"x":0.36258,"y":0.74646,"w":0.08584,"h":0.01279,"fs":0.01279,"n":1,"t":"例如，"},{"x":0.48395,"y":0.76598,"w":0.11154,"h":0.03035,"fs":0.01918,"n":2,"t":"d dx (ekx) = ekx # d"},{"x":0.5837,"y":0.77482,"w":0.24623,"h":0.02151,"fs":0.01279,"n":2,"t":"dx (kx) = kekx，对于任何常数 k"},{"x":0.36255,"y":0.80695,"w":0.02362,"h":0.01279,"fs":0.01279,"n":1,"t":"和"},{"x":0.55512,"y":0.82091,"w":0.11245,"h":0.0359,"fs":0.01918,"n":2,"t":"d dx1ex22 = ex2 # d"},{"x":0.65577,"y":0.83436,"w":0.10329,"h":0.02246,"fs":0.01279,"n":1,"t":"dx (x2) = 2xex2."},{"x":0.36258,"y":0.88243,"w":0.24668,"h":0.01375,"fs":0.01375,"n":1,"t":"链式法则的重复使用"},{"x":0.36258,"y":0.90709,"w":0.52868,"h":0.01279,"fs":0.01279,"n":1,"t":"有时我们需要两次或更多次使用链式法则来找到一个导数。"}]}