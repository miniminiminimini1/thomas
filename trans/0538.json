44,"w":0.59302,"h":0.04732,"fs":0.01279,"n":3,"t":""},{"x":0.32332,"y":0.57432,"w":0.59297,"h":0.03197,"fs":0.01279,"n":2,"t":"美国心脏协会对于2级高血压的定义是什么？(c) 有多少百分比的人血压处于美国心脏协会设定的正常范围90-120毫米汞柱？"},{"x":0.35277,"y":0.60885,"w":0.19263,"h":0.01279,"fs":0.01279,"n":1,"t":"美国心脏协会？"},{"x":0.32332,"y":0.63421,"w":0.59303,"h":0.02899,"fs":0.01279,"n":2,"t":"解答 (a) 由于我们无法找到不定积分，我们使用计算机来评估正态概率密度函数的积分，其中m = 119.7，s = 10.9："},{"x":0.35277,"y":0.66508,"w":0.54042,"h":0.01347,"fs":0.01279,"n":1,"t":"160"},{"x":0.55417,"y":0.68333,"w":0.01725,"h":0.00895,"fs":0.00895,"n":1,"t":"1/(10.9√2π)e^(-(X-119.7)^2/(2*10.9^2)) dX ≈0.03117."},{"x":0.57153,"y":0.68793,"w":0.28298,"h":0.03216,"fs":0.01279,"n":3,"t":"P(140 ≤ X ≤ 160) ="},{"x":0.38116,"y":0.69577,"w":0.14802,"h":0.01347,"fs":0.01279,"n":1,"t":"140"},{"x":0.54681,"y":0.71159,"w":0.01725,"h":0.00895,"fs":0.00895,"n":1,"t":"140"},{"x":0.32332,"y":0.72587,"w":0.59292,"h":0.01279,"fs":0.01279,"n":1,"t":"这意味着在研究年龄范围内的大约3%的人口患有1级高血压。"},{"x":0.32332,"y":0.74121,"w":0.59296,"h":0.03197,"fs":0.01279,"n":2,"t":"（b）我们再次使用计算机来计算血压在160到180毫米汞柱之间的概率："},{"x":0.35276,"y":0.77574,"w":0.19765,"h":0.01279,"fs":0.01279,"n":1,"t":"180"},{"x":0.55336,"y":0.79332,"w":0.01725,"h":0.00895,"fs":0.00895,"n":1,"t":"1 10.922p e-(X-119.7)2>2(10.9)2 dX ≈0.00011."},{"x":0.57071,"y":0.79792,"w":0.28461,"h":0.03216,"fs":0.01279,"n":3,"t":"P(160 … X … 180) ="},{"x":0.38033,"y":0.80575,"w":0.14802,"h":0.01347,"fs":0.01279,"n":1,"t":"160"},{"x":0.54599,"y":0.82158,"w":0.01725,"h":0.00895,"fs":0.00895,"n":1,"t":"我们得出结论，大约有0.011%的人口患有2级高血压。（c）血压处于正常范围内的概率是"},{"x":0.32332,"y":0.83969,"w":0.52465,"h":0.03197,"fs":0.01279,"n":2,"t":""},{"x":0.54927,"y":0.87773,"w":0.01725,"h":0.00895,"fs":0.00895,"n":1,"t":"120"},{"x":0.56663,"y":0.88233,"w":0.28461,"h":0.03216,"fs":0.01279,"n":3,"t":"1 10.922p e-(X-119.7)^2>2(10.9)^2 dX ≈0.50776."},{"x":0.38442,"y":0.89017,"w":0.13985,"h":0.01347,"fs":0.01279,"n":1,"t":"P(90 … X … 120) ="},{"x":0.54191,"y":0.90599,"w":0.01149,"h":0.00895,"fs":