8921,"w":0.11244,"h":0.02729,"fs":0.01279,"n":2,"t":"d/dx (u + y) = du/dx"},{"x":0.6757,"y":0.79642,"w":0.02193,"h":0.02006,"fs":0.01279,"n":1,"t":"dx."},{"x":0.32332,"y":0.86596,"w":0.59302,"h":0.03329,"fs":0.01279,"n":2,"t":"例如，如果 y = x^4 + 12x，那么 y 是 u(x) = x^4 和 y(x) = 12x 的和。因此我们有"},{"x":0.48956,"y":0.9066,"w":0.05171,"h":0.02973,"fs":0.01279,"n":2,"t":"dy/dx = d/dx (x^4) + d/dx (12x) = 4x^3 + 12."},{"x":0.52947,"y":0.90905,"w":0.08395,"h":0.0276,"fs":0.01401,"n":1,"t":""},{"x":0.60162,"y":0.91111,"w":0.14448,"h":0.02524,"fs":0.01279,"n":1,"t":""}]}